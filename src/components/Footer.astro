---
/**
 * Footer mínimo — sin menú. Solo identidad + links legales.
 * Se renderiza en todas las páginas vía <Layout>.
 */
import Isotipo from './Isotipo.astro';

const base = import.meta.env.BASE_URL;
const link = (href: string) =>
	href.startsWith('/') && href.length > 1 && !href.startsWith('//') ? base + href.slice(1) : href;

const legalLinks = [
	{ label: 'Política de privacidad', href: '/politica-de-privacidad/' },
	{ label: 'Aviso legal', href: '/aviso-legal/' },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-divider/40 bg-surface">
	<div
		class="mx-auto flex max-w-7xl flex-col items-start gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
	>
		<!-- Identidad -->
		<a
			href={base || '/'}
			class="flex items-center gap-4 hover:no-underline"
			aria-label="Inicio — Facultad Lalangue"
		>
			<Isotipo
				class="h-9 w-auto"
				wine="var(--color-brand)"
				accent="var(--color-accent)"
				indigo="var(--color-indigo)"
			/>
			<span class="flex flex-col leading-none">
				<span
					class="flex w-full justify-between font-heading text-[0.625rem] font-medium leading-none text-night/70"
				>
					<span>F</span><span>A</span><span>C</span><span>U</span
					><span>L</span><span>T</span><span>A</span><span>D</span>
				</span>
				<span
					class="-ml-[0.05em] font-heading text-[0.9375rem] font-semibold leading-none text-night"
				>
					Lalangue
				</span>
			</span>
		</a>

		<!-- Copyright -->
		<p class="text-xs text-muted">
			© {year} Facultad Internacional de Psicología y Psicoanálisis Lalangue
		</p>

		<!-- Links legales -->
		<nav aria-label="Legal">
			<ul class="flex flex-wrap gap-x-5 gap-y-2">
				{
					legalLinks.map((l) => (
						<li>
							<a
								href={link(l.href)}
								class="text-sm text-muted transition-colors hover:text-brand hover:no-underline"
							>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</footer>
