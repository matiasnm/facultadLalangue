{/* Slider de PROFESORES: autoplay sin puntitos. Soporta varios sliders por
     página; cada uno avanza de a una tarjeta y vuelve al inicio al llegar al
     final. Las flechas son opcionales. Pausa al hover y al foco (para que las
     tarjetas sean usables) y se apaga con prefers-reduced-motion.
     Los módulos de clases NO usan este slider: se desplazan solos como
     marquee CSS continuo (.modulos-marquee-track). */}
<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const initSlider = (slider) => {
		const viewport = slider.querySelector('[data-profesores-viewport]');
		const prev = slider.querySelector('[data-profesores-prev]');
		const next = slider.querySelector('[data-profesores-next]');
		if (!viewport) return;

		// Un paso = una tarjeta + el gap (gap-5 = 1.25rem).
		const card = () => viewport.querySelector('li');
		const step = () => (card()?.offsetWidth ?? 0) + 20;

		const go = (dir) => {
			const max = viewport.scrollWidth - viewport.clientWidth;
			const target = viewport.scrollLeft + dir * step();
			viewport.scrollTo({ left: Math.max(0, Math.min(target, max)), behavior: 'smooth' });
		};

		prev?.addEventListener('click', () => go(-1));
		next?.addEventListener('click', () => go(1));

		let timer = 0;
		const stop = () => window.clearInterval(timer);
		const start = () => {
			stop();
			if (reduceMotion) return;
			timer = window.setInterval(() => {
				const max = viewport.scrollWidth - viewport.clientWidth;
				// Al llegar al final vuelve al inicio (loop cerrado).
				if (viewport.scrollLeft >= max - 4) {
					viewport.scrollTo({ left: 0, behavior: 'smooth' });
				} else {
					go(1);
				}
			}, 4000);
		};

		slider.addEventListener('mouseenter', stop);
		slider.addEventListener('mouseleave', start);
		slider.addEventListener('focusin', stop);
		slider.addEventListener('focusout', start);
		start();
	};

	document.querySelectorAll('[data-profesores-slider]').forEach(initSlider);
</script>

