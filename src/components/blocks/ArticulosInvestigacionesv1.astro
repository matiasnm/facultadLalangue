---
import { getCollection } from 'astro:content';
import ArticuloInvestigacionCard from './ArticuloInvestigacionCard.astro';
import 'swiper/css';
import 'swiper/css/a11y';

const articulos = (await getCollection('articulos-investigaciones')).sort(
  (a, b) => a.data.peso - b.data.peso || b.data.fecha.getTime() - a.data.fecha.getTime(),
);
const destacados = articulos.slice(0, 2);
const slides = articulos.slice(2);
---

{articulos.length > 0 && (
  <section id="articulos-investigaciones" class="articulos-investigaciones-v1" aria-labelledby="articulos-investigaciones-titulo">
    <header class="section-header">
      <h2 id="articulos-investigaciones-titulo">Artículos e investigaciones <span aria-hidden="true">→</span></h2>
    </header>
    <div class="featured-cards">
      {destacados.map((articulo, index) => <ArticuloInvestigacionCard articulo={articulo} destacado={index === 0} />)}
    </div>
    {slides.length > 0 && (
      <articulos-investigaciones-v1>
        <div class="swiper articles-swiper" role="region" aria-roledescription="carrusel" aria-label="Más artículos e investigaciones">
          <div class="swiper-wrapper">
            {slides.map((articulo) => (
              <div class="swiper-slide"><ArticuloInvestigacionCard articulo={articulo} /></div>
            ))}
          </div>
        </div>
        <div class="carousel-controls" hidden>
          <div class="progress-track" role="progressbar" aria-label="Progreso del carrusel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="progress-fill"></span></div>
          <div class="carousel-arrows">
            <button type="button" data-prev aria-label="Artículos anteriores"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></button>
            <button type="button" data-next aria-label="Artículos siguientes"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></button>
          </div>
        </div>
      </articulos-investigaciones-v1>
    )}
  </section>
)}

<style>
  .articulos-investigaciones-v1 { margin-block: 5rem; }
  .section-header { margin-bottom: 2.5rem; }
  h2 { display: flex; align-items: center; gap: 1rem; margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 500; line-height: 1.5; }
  h2 span { color: var(--color-brand); }
  .featured-cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  articulos-investigaciones-v1 { display: block; min-width: 0; margin-top: 1.5rem; }
  .articles-swiper { overflow: hidden; }
  .swiper-slide { display: flex; height: auto; }
  .articles-swiper:not(.swiper-initialized) .swiper-wrapper { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .carousel-controls { display: flex; align-items: center; gap: 2rem; margin-top: 2rem; }
  .carousel-controls[hidden] { display: none; }
  .progress-track { flex: 1; height: 2px; background: var(--color-divider); overflow: hidden; }
  .progress-fill { display: block; width: 100%; height: 100%; background: var(--color-brand); transform: scaleX(var(--article-progress, 0)); transform-origin: left; transition: transform .3s; }
  .carousel-arrows { display: flex; gap: .5rem; }
  .carousel-arrows button { display: grid; place-items: center; width: 3rem; height: 3rem; padding: 0; border: 1px solid var(--color-ink); border-radius: 50%; color: var(--color-ink); background: transparent; transition: color .2s, background .2s; }
  .carousel-arrows button:hover:not(:disabled) { background: var(--color-ink); color: white; }
  .carousel-arrows button:disabled { opacity: .3; cursor: default; }
  .carousel-arrows button:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 4px; }
  @media (min-width: 40rem) { .articles-swiper:not(.swiper-initialized) .swiper-wrapper { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 48rem) { .featured-cards { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); } }
  @media (min-width: 64rem) { .articles-swiper:not(.swiper-initialized) .swiper-wrapper { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .progress-fill, .carousel-arrows button { transition: none; } }
</style>

<script>
  import Swiper from 'swiper';
  import { A11y, Keyboard, Navigation } from 'swiper/modules';

  class ArticulosInvestigacionesCarousel extends HTMLElement {
    private swiper?: Swiper;
    private events?: AbortController;

    connectedCallback() {
      if (this.swiper) return;
      const carousel = this.querySelector<HTMLElement>('.articles-swiper');
      const previous = this.querySelector<HTMLButtonElement>('[data-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-next]');
      const controls = this.querySelector<HTMLElement>('.carousel-controls');
      const progress = this.querySelector<HTMLElement>('.progress-track');
      if (!carousel || !previous || !next || !controls || !progress) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const updateProgress = (swiper: Swiper) => {
        // Include the initially visible cards in the progress, as on the reference.
        const total = swiper.snapGrid.length;
        const value = total <= 1 ? 1 : (swiper.snapIndex + 1) / total;
        progress.style.setProperty('--article-progress', String(value));
        progress.setAttribute('aria-valuenow', String(Math.round(value * 100)));
      };

      this.swiper = new Swiper(carousel, {
        modules: [A11y, Keyboard, Navigation],
        slidesPerView: 1.1,
        spaceBetween: 16,
        speed: reducedMotion.matches ? 0 : 400,
        watchOverflow: true,
        grabCursor: true,
        breakpoints: { 640: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
        keyboard: { enabled: true, onlyInViewport: true },
        navigation: { prevEl: previous, nextEl: next, addIcons: false },
        a11y: {
          prevSlideMessage: 'Artículos anteriores',
          nextSlideMessage: 'Artículos siguientes',
          containerRoleDescriptionMessage: 'carrusel',
          itemRoleDescriptionMessage: 'diapositiva',
          slideLabelMessage: '{{index}} de {{slidesLength}}',
        },
        on: { init: updateProgress, slideChange: updateProgress, resize: updateProgress, snapGridLengthChange: updateProgress },
      });
      controls.hidden = false;
      this.events = new AbortController();
      reducedMotion.addEventListener('change', (event) => {
        if (this.swiper) this.swiper.params.speed = event.matches ? 0 : 400;
      }, { signal: this.events.signal });
    }

    disconnectedCallback() {
      this.events?.abort();
      this.swiper?.destroy(true, true);
      this.swiper = undefined;
      const controls = this.querySelector<HTMLElement>('.carousel-controls');
      if (controls) controls.hidden = true;
    }
  }
  if (!customElements.get('articulos-investigaciones-v1')) {
    customElements.define('articulos-investigaciones-v1', ArticulosInvestigacionesCarousel);
  }
</script>
