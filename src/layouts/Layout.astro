---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { base } from '../lib/link';
import { defaultTokens as TOKENS } from '../data/paletas';

interface Props {
	title: string;
	/** Home: header transparente sobre el hero, opaco al scrollear. */
	overlay?: boolean;
}

const { title, overlay = false } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Favicons: ICO (legado) → SVG/PNG vectorial → PNG de alta resolución → apple-touch -->
		<link rel="icon" href={base + 'favicon.ico'} sizes="any" />
		<link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
		<link rel="icon" type="image/png" sizes="16x16" href={base + 'favicon-16x16.png'} />
		<link rel="icon" type="image/png" sizes="32x32" href={base + 'favicon-32x32.png'} />
		<link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Tipografías: DM Sans (cuerpo), Montserrat (h1), Poppins (h2–h6), Roboto Condensed (menú) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600&family=Roboto+Condensed:wght@400;600&display=swap"
			rel="stylesheet"
		/>

		<!-- Paleta en vivo (selector en /roadmap → "Editor de paleta en vivo").
		     Al cargar cualquier página, se leen los colores guardados en
		     localStorage y se sobreescriben los tokens en :root, de modo que
		     el sitio entero (incluido el header y el isotipo) se repinta. -->
		<script define:vars={{ TOKENS }}>
			(() => {
				const KEY = 'lalangue-paleta';
				// TOKENS = tokens del tema default (Terracota apagado), importados
				// de src/data/paletas.ts (defaultTokens): la única fuente TS de los
				// valores por defecto (global.css solo espeja los mismos valores
				// para el build de Tailwind, no puede importar TS).
				// (El editor de /roadmap guarda cualquier token en localStorage;
				//  acá se aplican todos los que haya: la elección de tema repinta
				//  el sitio entero, incluido el isotipo del header y el footer.)
				window.__LALANGUE_PALETA = { KEY, TOKENS };
				try {
					const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
					if (saved) {
						for (const [k, v] of Object.entries(saved)) {
							if (typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v)) {
								document.documentElement.style.setProperty(`--color-${k}`, v);
							}
						}
					}
				} catch (e) {
					/* paleta dañada: ignorar y usar defaults */
				}
				// Isotipo con colores propios, independientes de la paleta del
				// sitio. El editor de /roadmap guarda la elección en
				// 'lalangue-iso' como { pal, c1, c2, c3 } — hex literales. Sin
				// elección (o inválida), el isotipo usa la paleta "Original":
				// vino / naranja cálido / índigo, los colores de siempre.
				let iso = null;
				try {
					iso = JSON.parse(localStorage.getItem('lalangue-iso') || 'null');
				} catch (e) {
					iso = null;
				}
				const hex = (v, fb) =>
					typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v) ? v : fb;
				const ISO_DEF = { c1: '#8c1c3f', c2: '#d5673f', c3: '#45426d' };
				document.documentElement.style.setProperty('--iso-c1', hex(iso && iso.c1, ISO_DEF.c1));
				document.documentElement.style.setProperty('--iso-c2', hex(iso && iso.c2, ISO_DEF.c2));
				document.documentElement.style.setProperty('--iso-c3', hex(iso && iso.c3, ISO_DEF.c3));
				// Logo del navbar: Isotipo (default) o Bandera. Se aplica como
				// data-logo-nav en <html> para que el CSS muestre el SVG que
				// corresponde (ver .logo-nav-* en global.css). El roadmap lo
				// cambia en vivo con la misma key.
				let logoNav = 'isotipo';
				try {
					if (localStorage.getItem('lalangue-logo-nav') === 'bandera') logoNav = 'bandera';
				} catch (e) {
					/* ignorar */
				}
				document.documentElement.dataset.logoNav = logoNav;
				// Altura del logo del navbar (roadmap → "Logo del navbar").
				// Se guarda como 'lalangue-logo-h' (px, 8..24); default 11
				// (= h-11, el tamaño clásico de Tailwind: 2.75rem / 44px).
				let logoH = 11;
				try {
					const n = parseInt(localStorage.getItem('lalangue-logo-h') || '', 10);
					if (Number.isFinite(n) && n >= 8 && n <= 24) logoH = n;
				} catch (e) {
					/* ignorar */
				}
				document.documentElement.style.setProperty('--logo-h', String(logoH));
			})();
		</script>
	</head>
	{/* body como columna flex: el contenido crece (el <main> de cada página
	     lleva flex-1) para anclar el footer al fondo cuando la página es
	     corta (p. ej. el 404, que se auto-ancla con su min-h). */}
	<body class="flex min-h-screen flex-col bg-background text-ink">
		<Header overlay={overlay} />
		<slot />
		<Footer />
	</body>
</html>