---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { link } from '../../lib/link';

export async function getStaticPaths() {
  return (await getCollection('articulos-investigaciones')).map((articulo) => ({
    params: { id: articulo.id },
    props: { articulo },
  }));
}
interface Props { articulo: CollectionEntry<'articulos-investigaciones'>; }
const { articulo } = Astro.props;
const { data } = articulo;
const { Content } = await render(articulo);
---

<Layout title={`${data.titulo} — Facultad Lalangue`}>
  <main class="contenedor-lectura flex-1 py-12">
    <a href={link('/nuestra-biblioteca/#articulos-investigaciones')}>← Volver a la biblioteca</a>
    <article>
      <header>
        <p class="category">{data.categoria}{data.ejemplo && ' · Contenido de ejemplo'}</p>
        <h1>{data.titulo}</h1>
        <p class="description">{data.descripcion}</p>
        <p class="meta">{data.autor} · <time datetime={data.fecha.toISOString()}>{data.fecha.toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
        <Image src={data.imagen} alt={data.imagenAlt} widths={[480, 768, 1024]} sizes="(min-width: 48rem) 48rem, 100vw" />
      </header>
      <div class="article-body"><Content /></div>
    </article>
  </main>
</Layout>

<style>
  article { margin-top: 2.5rem; }
  .category { color: var(--color-brand); font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; }
  h1 { font-size: clamp(1.875rem, 4vw, 2.75rem); }
  .description { font-size: 1.125rem; }
  .meta { color: var(--color-muted); font-size: .875rem; }
  header img { margin-top: 2rem; width: 100%; height: auto; }
  .article-body { margin-top: 2rem; font-size: .9375rem; line-height: 1.8; }
  .article-body :global(h2) { margin-top: 2rem; }
</style>
