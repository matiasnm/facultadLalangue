---
/**
 * Página /plantel-academico — Plantel Académico.
 *
 * Declara el encabezado y renderiza los bloques de src/data/plantel.ts
 * (decana, directores, comité científico, plantel docente y formaciones) a
 * través de BloqueRender / ComponenteComun.
 */
import Layout from '../layouts/Layout.astro';
import { plantelSecciones } from '../data/plantel';
import BloqueRender from '../components/formacion/BloqueRender.astro';
import ComponenteComun from '../components/formacion/ComponenteComun.astro';
import ModalPersona from '../components/ModalPersona.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Plantel Académico — Facultad Internacional de Psicología y Psicoanálisis Lalangue">
	<main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
		<!-- Volver al inicio -->
		<a
			href={base || '/'}
			class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-accent hover:no-underline"
		>
			<span aria-hidden="true">←</span> Volver al inicio
		</a>

		<!-- Encabezado -->
		<header class="mt-6">
			<p class="text-xs font-semibold uppercase tracking-widest text-accent">Conócenos</p>
			<h1 class="mt-2 max-w-4xl text-4xl font-semibold leading-tight sm:text-5xl">
				Plantel Académico
			</h1>
			<p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink/80">
				El equipo docente Lalangue está compuesto por profesionales de renombre
				con amplia experiencia en psicoanálisis, psicoterapia e investigación.
			</p>
		</header>

		<!-- Contenido -->
		<div class="mt-12">
			{plantelSecciones.map((seccion) =>
				seccion.tipo === 'componente' ? (
					<ComponenteComun nombre={seccion.nombre} />
				) : (
					<BloqueRender bloque={seccion} />
				),
			)}
		</div>
	</main>

	<!-- Popup de perfil para docentes y directores -->
	<ModalPersona />
</Layout>