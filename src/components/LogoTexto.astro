---
/**
 * LogoTexto — wordmark "FACULTAD / Lalangue".
 *
 * "FACULTAD" se escribe en Montserrat letra por letra y el ancho se reparte
 * con justify-between para encajar exactamente sobre el ancho de "Lalangue"
 * (compensando el side bearing de la L con -ml-[0.05em]). Reemplaza las copias
 * que vivían en Header, Footer y la vista previa del navbar del roadmap.
 *
 * Escalas:
 *   - header: 0.8203rem / 1.2891rem — navbar.
 *   - footer: 0.625rem / 0.9375rem  — pie.
 *   - mini:   0.8203rem / 1.2891rem — vistas previas sobre fondo claro.
 *
 * Colores por defecto: "FACULTAD" al 70% y "Lalangue" pleno. Se pueden
 * sobrescribir con `fgDim` / `fg`; el header los usa para el modo overlay
 * (texto blanco sobre el hero).
 */
interface Props {
	/** Escala del par de líneas. */
	scale?: 'header' | 'footer' | 'mini';
	/** Clases de color de "FACULTAD" (línea superior). */
	fgDim?: string;
	/** Clases de color de "Lalangue" (línea inferior). */
	fg?: string;
}

const { scale = 'header', fgDim = 'text-night/70', fg = 'text-night' } = Astro.props;

const escalas = {
	header: { facultad: 'text-[0.8203rem] font-medium', lalangue: 'text-[1.2891rem] font-semibold' },
	footer: { facultad: 'text-[0.625rem] font-medium', lalangue: 'text-[0.9375rem] font-semibold' },
	mini: { facultad: 'text-[0.8203rem] font-medium', lalangue: 'text-[1.2891rem] font-semibold' },
} as const;
const e = escalas[scale];
---

<span class="flex flex-col leading-none">
	<span class={`flex w-full justify-between font-heading leading-none ${e.facultad} ${fgDim}`}>
		<span>F</span><span>A</span><span>C</span><span>U</span><span>L</span><span>T</span><span>A</span><span>D</span>
	</span>
	<span class={`-ml-[0.05em] font-heading leading-none ${e.lalangue} ${fg}`}>
		Lalangue
	</span>
</span>
