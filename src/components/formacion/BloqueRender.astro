{/* Marquee de módulos: desplazamiento continuo idéntico al de LogoCarrusel
     (la copia aria-hidden ocupa la segunda mitad del track; -50% = una copia). */}
<style>
	.modulos-marquee-track {
		animation: modulos-marquee-scroll 28s linear infinite;
	}
	.modulos-marquee-track:hover,
	.modulos-marquee-track:focus-within {
		animation-play-state: paused;
	}
	@keyframes modulos-marquee-scroll {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.modulos-marquee-track {
			animation: none;
		}
	}
</style>

