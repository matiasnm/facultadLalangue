---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Página no encontrada — Facultad Lalangue">
	<div
		class="mx-auto flex min-h-[60dvh] w-full max-w-7xl flex-col items-center justify-center px-4 py-20 text-center sm:px-6 lg:px-8"
	>
		<p class="font-display text-6xl font-semibold text-brand sm:text-7xl">404</p>
		<h1 class="mt-4 text-3xl font-semibold sm:text-4xl">
			No encontramos esa página
		</h1>
		<p class="mt-4 max-w-xl text-ink/80 leading-relaxed">
			La dirección que buscás no existe o fue movida. Revisá el enlace o volvé
			al inicio para explorar nuestras formaciones y la comunidad.
		</p>
		<a
			href={base || '/'}
			class="mt-8 rounded-md bg-accent px-6 py-3 font-display text-base font-semibold uppercase tracking-wide text-night transition-colors hover:bg-brand hover:text-white hover:no-underline"
		>
			Volver al inicio
		</a>
	</div>
</Layout>
