---
/**
 * BloqueRender — diseño de cada tipo de bloque.
 *
 * Este es EL ÚNICO lugar donde se define el estilo de los bloques que usan las
 * páginas de formación. Si mañana cambia el diseño de una tarjeta de beneficio,
 * un chip, una cita o un CTA, se cambia acá y todas las páginas se actualizan.
 * Las páginas no llevan diseño propio: solo declaran datos (componentes.ts +
 * formaciones.ts) y los renderizan a través de este componente.
 */
import Rico from './Rico.astro';
import Contador from './Contador.astro';
import Avatar from '../Avatar.astro';
import { siglasDe } from '../../data/docentes';
import type { Bloque, IconoFacultad, IconoMetodologia } from '../../data/componentes';

const base = import.meta.env.BASE_URL;
// Prefija rutas internas con la base; deja intactas "#", anclas y URLs absolutas.
const link = (href: string) =>
	href.startsWith('/') && href.length > 1 && !href.startsWith('//') ? base + href.slice(1) : href;

interface Props {
	bloque: Bloque;
}

const { bloque: b } = Astro.props;

const chevron = `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-accent transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>`;
// Íconos de la tarjeta "dirigido-a" (check / cruz en círculo), heredan el color.
// La cruz va en la paleta "accent" (terracota) para distinguirla del check (brand/vino).
const checkIcon = `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0 text-brand"><circle cx="12" cy="12" r="10"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>`;
const crossIcon = `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0 text-accent"><circle cx="12" cy="12" r="10"/><path d="m9 9 6 6m0-6-6 6"/></svg>`;

// Iconos minimalistas (trazo fino, sin relleno) de la modalidad metodológica:
// clase sincrónica (play), grabaciones (pantalla), prácticas supervisadas
// (clipboard con check), discusión de casos (burbuja), salida laboral
// (avión de papel) y comunidad activa (globo); + lupa para investigación.
const iconosMetodologia: Record<IconoMetodologia, string> = {
	clase: `<circle cx="12" cy="12" r="9"/><path d="m10 8.5 5.5 3.5-5.5 3.5z"/>`,
	grabaciones: `<rect x="3" y="4.5" width="18" height="12" rx="1.5"/><path d="M9 16.5v3M15 16.5v3M7 19.5h10"/><path d="m10.5 8 3.75 2.25-3.75 2.25z"/>`,
	supervision: `<rect x="5.5" y="3.5" width="13" height="17" rx="1.5"/><path d="M9.5 3.5V6h5V3.5"/><path d="m9 13 2 2 4-4.5"/>`,
	casos: `<path d="M4 7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3h-7l-4.5 3.5V15H7a3 3 0 0 1-3-3z"/><path d="M8 9.5h.01M12 9.5h.01M16 9.5h.01"/>`,
	salida: `<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/>`,
	comunidad: `<circle cx="12" cy="12" r="9"/><path d="M3.5 12h17"/><path d="M12 3a14.5 14.5 0 0 1 0 18 14.5 14.5 0 0 1 0-18"/>`,
	investigacion: `<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4-4"/>`,
};

// Lema de articula: "frase **Palabra clave**". La frase va arriba y la palabra
// clave abajo, sola, grande y en vino. Separa ambos para renderizarlas aparte.
function lemaPartes(linea: string): { antes: string; palabra: string; despues: string } {
	const m = linea.match(/\*\*(.+?)\*\*/);
	if (!m) return { antes: linea.trim(), palabra: '', despues: '' };
	return {
		antes: linea.slice(0, m.index ?? 0).trim(),
		palabra: m[1],
		despues: linea.slice((m.index ?? 0) + m[0].length).trim(),
	};
}

// Iconos minimalistas (trazo fino, sin relleno) de los pilares institucionales.
// Representan la misma idea que los iconos FontAwesome del original (globo,
// pizarrón, certificado, usuarios, maletín y estetoscopio) pero con el mínimo
// detalle posible.
const iconosFacultad: Record<IconoFacultad, string> = {
	globo: `<circle cx="12" cy="12" r="9"/><path d="M3.5 12h17"/><path d="M12 3a14.5 14.5 0 0 1 0 18 14.5 14.5 0 0 1 0-18"/>`,
	docentes: `<rect x="3.5" y="3.5" width="17" height="11.5" rx="1.5"/><path d="M8.5 15v5.5M15.5 15v5.5M6 20.5h12"/><path d="M7.5 8.5h9"/>`,
	certificado: `<circle cx="12" cy="9.5" r="5.75"/><path d="m9.75 9.5 1.6 1.6 3-3.25"/><path d="M7.5 14.5 6 21l6-2.75L18 21l-1.5-6.5"/>`,
	comunidad: `<circle cx="9" cy="9" r="3.5"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17.5" cy="10" r="2.5"/><path d="M15 19a4.5 4.5 0 0 1 5 0"/>`,
	insercion: `<rect x="3" y="7.5" width="18" height="11" rx="2"/><path d="M9 7.5v-2a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M12 12.5v3M9.6 14h.01M14.4 14h.01"/>`,
	clinica: `<path d="M6 3v6.5a6 6 0 0 0 12 0V3"/><path d="M12 15.5v1.5"/><circle cx="12" cy="19" r="2.5"/>`,
};
---

{/* Título — h2/h3/h4 con kicker opcional (p. ej. "Incluido en tu formación") */}
{b.tipo === 'titulo' && (
	<>
		{b.kicker && (
			<p class="mt-14 text-xs font-semibold uppercase tracking-widest text-accent">{b.kicker}</p>
		)}
		{b.nivel === 3 ? (
			<h3 id={b.id} class="mt-10 scroll-mt-24">{b.texto}</h3>
		) : b.nivel === 4 ? (
			<h4 id={b.id} class="mt-6 scroll-mt-24">{b.texto}</h4>
		) : (
			<h2 id={b.id} class="mt-14 scroll-mt-24 first:mt-0">{b.texto}</h2>
		)}
	</>
)}

{/* Texto — uno o varios párrafos */}
{b.tipo === 'texto' && (
	<div class="mt-6 space-y-3">
		{b.parrafos.map((p) => (
			<Rico texto={p} class="max-w-3xl text-[0.9375rem] leading-relaxed text-ink/85" />
		))}
	</div>
)}

{/* Lista — numerada o con bullets */}
{b.tipo === 'lista' &&
	(b.ordenada ? (
		<ol class="mt-6 max-w-3xl space-y-2 text-[0.9375rem] leading-relaxed text-ink/85">
			{b.items.map((it) => (
				<li>
					<Rico texto={it} />
				</li>
			))}
		</ol>
	) : (
		<ul class="mt-6 max-w-3xl space-y-2 text-[0.9375rem] leading-relaxed text-ink/85">
			{b.items.map((it) => (
				<li>
					<Rico texto={it} />
				</li>
			))}
		</ul>
	))}

{/* Chips — insignias, sellos o lemas */}
{b.tipo === 'chips' && (
	<ul class="mt-6 flex list-none flex-wrap gap-2 p-0">
		{b.items.map((it) => (
			<li
				class:list={[
					'rounded-full border px-4 py-1.5 text-sm font-medium',
					b.variante === 'lema'
						? 'border-brand/20 bg-brand/5 font-semibold text-brand'
						: 'border-divider/60 bg-surface text-ink',
				]}
			>
				{it}
			</li>
		))}
	</ul>
)}

{/* Contadores — tarjetas animadas: suben de 0 al valor real al visualizarse */}
{b.tipo === 'contadores' && (
	<ul class="mt-6 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-3">
		{b.items.map((c) => (
			<li class="rounded-xl border border-divider/30 bg-surface p-5 text-center">
				<span class="block font-display text-3xl font-semibold text-brand">
					<Contador valor={c.valor} />
				</span>
				<span class="mt-1 block text-sm text-muted">{c.etiqueta}</span>
			</li>
		))}
	</ul>
)}

{/* Beneficio — tarjeta de valor con precio */}
{b.tipo === 'beneficio' && (
	<article class="mt-6 rounded-2xl border border-divider/30 bg-surface p-6">
		<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
			<h4 class="text-lg font-semibold text-ink-strong">{b.titulo}</h4>
			<span class="font-display text-2xl font-semibold text-brand">{b.precio}</span>
		</div>
		<p class="mt-1 text-sm font-medium text-muted">{b.subtitulo}</p>
		<p class="mt-2 max-w-3xl text-[0.9375rem] leading-relaxed text-ink/80">{b.descripcion}</p>
	</article>
)}

{/* Beneficios — grid "Beneficios exclusivos alumnos" con hover iluminado.
     Misma mecánica que la landing del Máster: una grilla sin bordes externos
     (las líneas entre celdas son el gap de 1px que deja ver el fondo del
     contenedor) donde cada tarjeta se "ilumina" en hover: fondo más claro y
     una línea brand que se expande desde la izquierda en su borde inferior.
     - `auto-rows-fr`: todas las tarjetas tienen la misma altura, sin importar
       el largo del texto.
     - El precio se fija abajo a la derecha (flex-col + flex-1 + text-right),
       a la misma distancia del borde (padding p-6) en todas.
     - Títulos enumerados 1., 2., 3., … según su posición en el grid (igual
       que el original).
     - Sin border radius. */}
{b.tipo === 'beneficios' && (
	<ul
		class={`mt-6 grid list-none auto-rows-fr gap-px border border-divider/30 bg-divider/40 p-0 ${
			b.columnas === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3'
		}`}
	>
		{b.items.map((bf, i) => (
			<li class="group relative flex flex-col gap-1 bg-surface p-4 transition-colors duration-300 hover:bg-white">
				<h4 class="text-lg font-semibold text-ink-strong">{i + 1}. {bf.titulo}</h4>
				<p class="mt-1 text-xs font-semibold uppercase tracking-widest text-accent/70">{bf.subtitulo}</p>
				<p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-ink/80">{bf.descripcion}</p>
				<span class="mt-4 block text-right font-display text-2xl font-semibold text-brand line-through">{bf.precio}</span>
				{/* Línea inferior que se expande al hover (igual que el original: vino/brand). */}
				<span
					class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] origin-left scale-x-0 bg-brand transition-transform duration-300 ease-out group-hover:scale-x-100"
					aria-hidden="true"
				/>
			</li>
		))}
	</ul>
)}

{/* Total de beneficios — tarjeta destacada con contador animado (€1.363,
     igual que el original: contador con prefijo €, miles con punto). */}
{b.tipo === 'total-beneficios' && (
	<div class="mt-6 rounded-2xl border border-dashed border-accent/50 bg-accent/5 p-6 text-center">
		<p class="text-xs font-semibold uppercase tracking-widest text-muted">{b.titulo}</p>
		<p class="mt-1 font-display text-4xl font-semibold text-brand">
			<Contador valor={b.valor} delimiter="." />
		</p>
		<p class="mt-2 text-sm text-ink/70">{b.nota}</p>
	</div>
)}

{/* Cita — blockquote con autor */}
{b.tipo === 'cita' && (
	<figure class="mt-8 max-w-3xl">
		<blockquote class="my-0 text-[0.9375rem] leading-relaxed text-ink-strong/90">
			{b.lineas.map((l) => (
				<p class="mb-2 last:mb-0">{l}</p>
			))}
		</blockquote>
		<figcaption class="mt-3 text-sm font-medium text-muted">— {b.autor}</figcaption>
	</figure>
)}

{/* Estadísticas de inserción — sección full-bleed con mapa mundial de fondo.
     El ancho es del 100vw rompiendo el contenedor max-w-5xl (técnica w-screen +
     -ml-[50vw] + left-1/2). Fondo oscuro (bg-night) con el worldMap a 25% de
     opacidad, tal como en la landing original del Máster. */}
{b.tipo === 'stats' && (
	<section
		class="relative left-1/2 -ml-[50vw] mt-8 w-screen scroll-mt-24 bg-night py-16 sm:py-20"
		aria-label="Inserción laboral"
	>
		{/* Mapa mundial de fondo (misma imagen de la landing, opacidad 25%). */}
		<div
			class="pointer-events-none absolute inset-0 opacity-25"
			style={`background-image:url('${link('/worldMap.webp')}'); background-size:cover; background-position:center;`}
			aria-hidden="true"
		></div>
		<div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-12 md:grid-cols-2 md:gap-16">
				{/* Barras por región */}
				<ul class="list-none space-y-6 p-0">
					{b.filas.map((f) => (
						<li>
							<div class="flex items-baseline justify-between gap-3">
								<span class="text-sm font-medium text-white/85">{f.region}</span>
								<span class="font-display font-semibold text-white">{f.pct}</span>
							</div>
							<div class="mt-2 h-2 overflow-hidden rounded-full bg-white/15">
								<div class="h-full rounded-full bg-white" style={`width:${f.pct}`}></div>
							</div>
						</li>
					))}
				</ul>
				{/* Frases de inserción */}
				<div class="space-y-5">
					{b.frases.map((fr) => (
						<p class="text-lg font-medium leading-snug text-white">{fr}</p>
					))}
				</div>
			</div>
			{/* Referencia de las fuentes */}
			<Rico texto={b.referencia} class="mt-12 text-xs leading-relaxed text-white/60" />
		</div>
	</section>
)}

{/* FAQ — acordeón sin JavaScript (<details>) */}
{b.tipo === 'faq' && (
	<details class="group mt-4 rounded-xl border border-divider/40 bg-surface">
		<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-ink-strong [&::-webkit-details-marker]:hidden">
			<span>{b.pregunta}</span>
			<span set:html={chevron} />
		</summary>
		<div class="px-5 pb-5">
			{b.respuesta.map((p) => (
				<Rico texto={p} class="text-[0.9375rem] leading-relaxed text-ink/85" />
			))}
			{b.lista && (
				<ul class="mt-3 space-y-1.5 text-[0.9375rem] leading-relaxed text-ink/85">
					{b.lista.map((it) => (
						<li>
							<Rico texto={it} />
						</li>
					))}
				</ul>
			)}
			{b.cierre?.map((p) => (
				<Rico texto={p} class="mt-3 text-[0.9375rem] leading-relaxed text-ink/85" />
			))}
		</div>
	</details>
)}

{/* CTA — panel de marca con acciones */}
{b.tipo === 'cta' && (
	<div class="mt-12 rounded-2xl bg-brand px-6 py-12 text-center sm:px-10">
		<h2 class="text-white">{b.titulo}</h2>
		{b.subtitulo && <p class="mt-2 text-white/85">{b.subtitulo}</p>}
		{b.acciones.map((a) => (
			<a
				href={link(a.href)}
				class="mt-6 inline-block rounded-md bg-white px-8 py-3 font-display text-base font-semibold uppercase tracking-wide text-brand transition-colors hover:bg-accent hover:text-white hover:no-underline"
			>
				{a.etiqueta}
			</a>
		))}
	</div>
)}

{/* Enlace — link destacado del cuerpo (programa, checkout, entrevista…) */}
{b.tipo === 'enlace' && (
	<p class="mt-6">
		<a
			href={link(b.href)}
			class="font-semibold text-brand underline underline-offset-4 transition-colors hover:text-accent"
			{...(/^https?:\/\//.test(b.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
		>
			{b.etiqueta}
		</a>
	</p>
)}

{/* Persona — perfil de docente/comité con foto (o avatar), nombre, título y bio */}
{b.tipo === 'persona' && (
	<article class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start">
		{b.foto ? (
			<img src={b.foto} alt={b.nombre} class="h-24 w-24 shrink-0 rounded-full object-cover" loading="lazy" />
		) : (
			<Avatar name={b.nombre} class="h-24 w-24 text-2xl" />
		)}
		<div>
			<h4 class="text-lg font-semibold text-ink-strong">{b.nombre}</h4>
			{b.titulo && <p class="text-sm font-medium text-muted">{b.titulo}</p>}
			<div class="mt-2 space-y-2">
				{b.bio.map((p) => (
					<Rico texto={p} class="text-[0.9375rem] leading-relaxed text-ink/80" />
				))}
			</div>
			{b.boton && (
				<a
					href={link(b.boton.href)}
					class="mt-4 inline-flex rounded-md border border-brand bg-brand px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent hover:no-underline"
					{...(/^https?:\/\//.test(b.boton.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				>
					{b.boton.etiqueta}
				</a>
			)}
		</div>
	</article>
)}

{/* Equipo — grid de personas (decana, directores, comité, plantel).
     Con `modal` las cards son botones que abren el popup de perfil. */}
{b.tipo === 'equipo' && (
	<ul
		class={`mt-6 grid list-none gap-6 p-0 sm:grid-cols-2 ${
			b.columnas === 2 ? 'lg:grid-cols-2' : b.columnas === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'
		}`}
	>
		{b.personas.map((p) => (
			<li>
				{b.modal ? (
					<button
						type="button"
						data-persona-card
						data-persona-nombre={p.nombre}
						data-persona-titulo={p.titulo ?? ''}
						data-persona-siglas={siglasDe(p.nombre)}
						data-persona-bio={JSON.stringify(Array.isArray(p.bio) ? p.bio : p.bio ? [p.bio] : [])}
						class="flex h-full w-full flex-col gap-3 rounded-xl border border-divider/30 bg-surface p-5 text-left transition-colors hover:border-brand/50 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
					>
						<span class="flex w-full items-center gap-4">
							{p.foto ? (
								<img src={p.foto} alt={p.nombre} class="h-16 w-16 shrink-0 rounded-full object-cover" loading="lazy" />
							) : (
								<Avatar name={p.nombre} class="h-16 w-16 text-lg" />
							)}
							<span class="min-w-0">
								<span class="block leading-snug font-semibold text-ink-strong">{p.nombre}</span>
								{p.titulo && <span class="mt-0.5 block text-sm text-muted">{p.titulo}</span>}
							</span>
						</span>
						<span class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-brand">
							Ver perfil
							<svg
								viewBox="0 0 24 24"
								class="h-3.5 w-3.5"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M7 17 17 7M8 7h9v9" />
							</svg>
						</span>
					</button>
				) : (
					<div class="flex h-full flex-col gap-3 rounded-xl border border-divider/30 bg-surface p-5">
						<div class="flex items-center gap-4">
							{p.foto ? (
								<img src={p.foto} alt={p.nombre} class="h-16 w-16 shrink-0 rounded-full object-cover" loading="lazy" />
							) : (
								<Avatar name={p.nombre} class="h-16 w-16 text-lg" />
							)}
							<div>
								<p class="font-semibold text-ink-strong">{p.nombre}</p>
								{p.titulo && <p class="text-sm text-muted">{p.titulo}</p>}
							</div>
						</div>
						{p.bio && (
							<div class="space-y-2">
								{p.bio.map((linea) => (
									<Rico texto={linea} class="text-sm leading-relaxed text-ink/75" />
								))}
							</div>
						)}
					</div>
				)}
			</li>
		))}
	</ul>
)}

{/* Tarjetas — cards con imagen, título, descripción y link (formaciones, etc.) */}
{b.tipo === 'tarjetas' && (
	<ul class="mt-6 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
		{b.items.map((t) => (
			<li class="flex flex-col overflow-hidden rounded-xl border border-divider/30 bg-surface">
				{t.imagen && (
					<img src={t.imagen} alt={t.titulo} class="h-40 w-full object-cover" loading="lazy" />
				)}
				<div class="flex flex-1 flex-col p-5">
					<p class="font-semibold text-ink-strong">{t.titulo}</p>
					{t.descripcion && (
						<p class="mt-2 flex-1 text-sm text-ink/75 leading-relaxed">{t.descripcion}</p>
					)}
					{t.href && (
						<a
							href={link(t.href)}
							class="mt-4 inline-flex w-fit items-center gap-2 text-sm font-semibold text-brand hover:text-accent hover:no-underline"
						>
							Conocé más <span aria-hidden="true">→</span>
						</a>
					)}
				</div>
			</li>
		))}
	</ul>
)}

{/* Dirigido-a — par de columnas que se miran ("Es para ti si" / "No es para ti si")
     con bordes redondeados hacia el interior, más cierre centrado con botón. */}
{b.tipo === 'dirigido-a' && (
	<div class="mt-8 rounded-[2rem] border border-divider/40 bg-surface/40 p-4 sm:p-6">
		<div class="grid list-none gap-4 p-0 md:grid-cols-2 md:gap-6">
			{/* Columna "para ti" — redondea su lado derecho (hacia la otra columna) */}
			<section class="rounded-2xl rounded-r-[2rem] border border-divider/30 bg-surface p-6 md:rounded-r-[2.5rem]">
				<h3 class="font-subheading text-xl font-semibold text-ink-strong">{b.positivos.titulo}</h3>
				<div class="mt-3 h-px w-12 bg-brand" aria-hidden="true"></div>
				<ul class="mt-4 list-none space-y-3 p-0">
					{b.positivos.items.map((it) => (
						<li class="flex items-start gap-3">
							<span set:html={checkIcon} />
							<span class="text-[0.9375rem] leading-relaxed text-ink/85">{it}</span>
						</li>
					))}
				</ul>
			</section>
			{/* Columna "no es para ti" — redondea su lado izquierdo (hacia la otra columna) */}
			<section class="rounded-2xl rounded-l-[2rem] border border-divider/30 bg-surface p-6 md:rounded-l-[2.5rem] md:translate-y-6">
				<h3 class="font-subheading text-xl font-semibold text-ink-strong">{b.negativos.titulo}</h3>
				<div class="mt-3 h-px w-12 bg-accent" aria-hidden="true"></div>
				<ul class="mt-4 list-none space-y-3 p-0">
					{b.negativos.items.map((it) => (
						<li class="flex items-start gap-3">
							<span set:html={crossIcon} />
							<span class="text-[0.9375rem] leading-relaxed text-ink/85">{it}</span>
						</li>
					))}
				</ul>
			</section>
		</div>
		{/* Cierre centrado con texto y botón */}
		<div class="mt-8 text-center">
			<Rico texto={b.pie.texto} class="text-lg font-semibold text-ink-strong" />
			<a
				href={link(b.pie.boton.href)}
				class="mt-5 inline-block rounded-md bg-brand px-8 py-3 font-display text-base font-semibold uppercase tracking-wide text-white transition-colors hover:bg-accent hover:text-white hover:no-underline"
				{...(/^https?:\/\//.test(b.pie.boton.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
			>
				{b.pie.boton.etiqueta}
			</a>
		</div>
	</div>
)}

{/* Carrusel de logos — marquee CSS infinito (misma idea que el image-carousel
     de Elementor en la landing). La lista se duplica (aria-hidden la copia)
     y el track se desplaza con una animación lineal continua; se pausa al
     hover y se desactiva si el usuario prefiere menos movimiento. Cada logo
     con `href` es un enlace externo (pestaña nueva) sin estilos propios. */}
{b.tipo === 'carrusel-logos' && (
	<div class="relative mt-6 overflow-hidden">
		{/* Fundidos laterales para que los logos entren/salgan suavemente. */}
		<div
			class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-white to-transparent"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-white to-transparent"
			aria-hidden="true"
		></div>
		<div role="region" aria-label="Instituciones asociadas" class="carrusel-logos-track flex w-max">
			<ul class="flex list-none items-center gap-12 p-0">
				{b.logos.map((logo) => (
					<li class="shrink-0">
						{logo.href ? (
							<a href={link(logo.href)} target="_blank" rel="noopener noreferrer">
								<img
									src={link(logo.src)}
									alt={logo.alt}
									class="h-10 w-auto opacity-70 grayscale"
									loading="lazy"
								/>
							</a>
						) : (
							<img
								src={link(logo.src)}
								alt={logo.alt}
								class="h-10 w-auto opacity-70 grayscale"
								loading="lazy"
							/>
						)}
					</li>
				))}
			</ul>
			{/* Copia exacta — aria-hidden para el bucle continuo sin saltos. */}
			<ul class="flex list-none items-center gap-12 p-0" aria-hidden="true">
				{b.logos.map((logo) => (
					<li class="shrink-0">
						{logo.href ? (
							<a href={link(logo.href)} tabindex="-1" aria-hidden="true">
								<img src={link(logo.src)} alt="" class="h-10 w-auto opacity-70 grayscale" loading="lazy" />
							</a>
						) : (
							<img src={link(logo.src)} alt="" class="h-10 w-auto opacity-70 grayscale" loading="lazy" />
						)}
					</li>
				))}
			</ul>
		</div>
	</div>
)}

<style>
	.carrusel-logos-track {
		animation: carrusel-logos-scroll 30s linear infinite;
	}
	.carrusel-logos-track:hover {
		animation-play-state: paused;
	}
	@keyframes carrusel-logos-scroll {
		from {
			transform: translateX(0);
		}
		to {
			/* -50% = exactamente una copia de la lista (2 copias, la copia
			   aria-hidden ocupa la segunda mitad). */
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.carrusel-logos-track {
			animation: none;
		}
	}
</style>
{/* Articula — sección "… articula:" con los ejes de la formación. Copia
     simplificada del bloque de articulación del landing original, adaptada
     a los estilos y la paleta del sitio: fondo full-bleed en gradiente claro
     (blanco → superficie), título h2 global centrado, columna izquierda con
     el lema institucional (frase arriba y palabra clave abajo, grande, en
     Roboto Serif vino, con un separador vino debajo; todo alineado a la
     izquierda) y columna derecha con los N ejes numerados que cubre la
     altura del contenedor (justify-between). En mobile una sola columna con
     los ejes primero (igual que el original invertía el orden). La palabra
     clave usa un tamaño propio de escala (1.75rem), siempre por debajo del
     h1 y a tono con el h2 de la sección. */}
{b.tipo === 'articula' && (
	<section
		class="relative left-1/2 -ml-[50vw] mt-8 w-screen scroll-mt-24 bg-gradient-to-b from-white to-surface py-16 sm:py-20"
		aria-label={b.titulo}
	>
		<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-center">{b.titulo}</h2>
			<div class="mt-8 flex flex-col-reverse gap-10 md:grid md:grid-cols-2 md:gap-14 lg:gap-20">
				{/* Izquierda: lema institucional, alineado a la izquierda. Cada
				     lema es frase arriba + palabra clave abajo (grande, vino). */}
				<div class="flex flex-col items-start gap-8 text-left">
					{b.lema.map((linea) => {
						const { antes, palabra, despues } = lemaPartes(linea);
						return (
							<div class="flex w-full flex-col items-start gap-4">
								<p class="mb-0 font-heading text-xl leading-relaxed text-ink sm:text-2xl">
									{antes}
									{palabra && <span class="mt-1 block font-serif font-bold leading-none text-brand text-[1.75rem]">{palabra}</span>}
									{despues}
								</p>
								<div class="h-[5px] w-full bg-brand" aria-hidden="true"></div>
							</div>
						);
					})}
				</div>
				{/* Derecha: ejes numerados — la lista cubre el alto del contenedor
				     (la columna del lema es más alta; justify-between reparte los
				     ejes a lo largo de todo el alto). */}
				<ol class="mt-0 flex h-full list-none flex-col justify-between gap-4 p-0">
					{b.puntos.map((p, i) => (
						<li class="flex items-start gap-4">
							<span class="w-[60px] shrink-0 text-center font-heading text-[2.5rem] font-bold leading-none text-brand">
								{i + 1}
							</span>
							<span class="text-[0.9375rem] leading-relaxed text-ink/85">{p}</span>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>
)}

{/* Facultad — bloque institucional compacto, copia más chica de las secciones
     94c731f (2 columnas: logo + eslogan "Primera y única facultad…" a la
     izquierda, párrafos de la formación a la derecha) y 61e4cdb (6 pilares con
     iconos minimalistas de trazo fino) de la landing. La imagen central del
     original no se usa. El eslogan lleva `**negrita**` = acento en vino. */}
{b.tipo === 'facultad' && (
	<section class="mt-14 rounded-3xl bg-surface p-6 sm:p-10">
		<h2 class="sr-only">La Facultad</h2>
		<div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
			{/* Izquierda: logo + eslogan */}
			<div class="flex flex-col items-start gap-5">
				<img
					src={link(b.logo)}
					alt="Facultad Internacional de Psicología y Psicoanálisis Lalangue"
					class="h-auto max-w-[200px] sm:max-w-[240px]"
					loading="lazy"
				/>
				<Rico
					texto={b.eslogan}
					class="mb-0 max-w-sm font-heading text-xl leading-snug text-ink [&_strong]:font-bold [&_strong]:text-brand sm:text-2xl"
				/>
			</div>
			{/* Derecha: párrafos de la formación */}
			<div class="space-y-3">
				{b.parrafos.map((p) => (
					<Rico texto={p} class="mb-0 text-[0.9375rem] leading-relaxed text-ink/85" />
				))}
			</div>
		</div>
		{/* Pilares: icono minimalista en círculo + texto */}
		<div class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
			{b.pilares.map((p) => (
				<div class="flex items-start gap-3">
					<span
						class="flex size-10 shrink-0 items-center justify-center rounded-full border border-brand/15 bg-brand/[0.06] text-brand"
						aria-hidden="true"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-[1.15rem]"
							set:html={iconosFacultad[p.icono]}
						></svg>
					</span>
					<p class="mb-0 pt-1.5 text-sm leading-relaxed text-ink/85">{p.texto}</p>
				</div>
			))}
		</div>
	</section>
)}

{/* Metodología — bloque de modalidad de cursada, misma estructura que
     "articula…" pero con un video en la columna derecha (placeholder por
     ahora: caja 16:9 con play). Izquierda: sellos de metodología (frase +
     palabra clave abajo en Roboto Serif vino, alineado a la izquierda, con
     separador vino). Debajo: grilla gris de bullets de modalidad (2
     columnas) con iconos minimalistas del mismo tipo que Facultad. */}
{b.tipo === 'metodologia' && (
	<section class="mt-14">
		<h2>{b.titulo}</h2>
		<div class="mt-8 grid items-center gap-10 md:grid-cols-2 md:gap-14">
			{/* Izquierda: sellos de metodología. */}
			<div class="flex flex-col items-start gap-8 text-left">
				{b.lema.map((linea) => {
					const { antes, palabra, despues } = lemaPartes(linea);
					return (
						<div class="flex w-full flex-col items-start gap-4">
							<p class="mb-0 font-heading text-xl leading-relaxed text-ink sm:text-2xl">
								{antes}
								{palabra && <span class="mt-1 block font-serif font-bold leading-none text-brand text-[1.75rem]">{palabra}</span>}
								{despues}
							</p>
							<div class="h-[5px] w-full bg-brand" aria-hidden="true"></div>
						</div>
					);
				})}
			</div>
			{/* Derecha: video (placeholder 16:9, sin src por ahora). */}
			<div
				class="relative flex aspect-video w-full items-center justify-center overflow-hidden rounded-2xl bg-ink/[0.06]"
				role="img"
				aria-label="Video de la modalidad de cursada — próximamente"
			>
				<span class="flex flex-col items-center gap-3 text-ink/40">
					<span class="flex size-14 items-center justify-center rounded-full bg-white text-brand">
						<svg viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 size-5" aria-hidden="true">
							<path d="M8 5.5v13l11-6.5z" />
						</svg>
					</span>
					<span class="text-sm">Video — próximamente</span>
				</span>
			</div>
		</div>
		{/* Bullets de modalidad: grilla gris (2 columnas) con iconos minimalistas. */}
		<div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
			{b.puntos.map((p) => (
				<div class="flex items-center gap-3 rounded-xl bg-ink/[0.05] px-4 py-3">
					<span
						class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white text-brand"
						aria-hidden="true"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-[1.05rem]"
							set:html={iconosMetodologia[p.icono]}
						></svg>
					</span>
					<p class="mb-0 text-sm leading-snug text-ink">{p.texto}</p>
				</div>
			))}
		</div>
	</section>
)}
{/* Admisión — sección full-bleed (w-screen + -ml-[50vw] + left-1/2) con fondo:
     imagen + tinte vino en una sola capa (gradiente + url). Margen global en la
     section; dentro solo 1 grid de 2 columnas. Ambos títulos son h2
     (tipografía base respetada) y quedan a la misma altura. Columna izquierda
     con flex para que los puntos cubran el alto disponible; la derecha es el
     card: cabecera roja con título, cuerpo blanco centrado con precio en rojo
     y botón invertido. */}
{b.tipo === 'admision' && (
	<section
		class="relative left-1/2 -ml-[50vw] mt-8 w-screen scroll-mt-24 overflow-hidden bg-night bg-cover bg-center py-16 sm:py-20"
		style={`background-image: linear-gradient(rgba(91,17,51,.85), rgba(91,17,51,.85)), url('${link(b.fondo)}')`}
		aria-label={b.izqTitulo}
	>
		<div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 px-4 sm:px-6 md:gap-14 lg:grid-cols-2 lg:px-8">
			{/* Columna izquierda: título y puntos con check (flex para repartir el alto). */}
			<div class="flex flex-col pt-4 md:pt-5">
				<h2 class="text-white uppercase">{b.izqTitulo}</h2>
				{b.izqTexto && <p class="mb-0 text-white/85">{b.izqTexto}</p>}
				<ul class="mt-4 m-0 flex flex-1 list-none flex-col justify-between gap-3 p-0 md:mt-6">
					{b.izqBullets.map((bullet) => (
						<li class="flex items-start gap-3 text-white/85">
							<span class="mt-0.5 flex size-5 flex-shrink-0 items-center justify-center rounded-full bg-white/15 text-accent" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3">
									<path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
								</svg>
							</span>
							<span>{bullet}</span>
						</li>
					))}
				</ul>
			</div>
			{/* Columna derecha: card de matrícula — cabecera roja + cuerpo blanco centrado. */}
			<div class="overflow-hidden rounded-2xl bg-white text-center">
				<div class="bg-brand px-6 py-4 md:px-8 md:py-5">
					<h2 class="text-white uppercase">{b.derTitulo}</h2>
				</div>
				<div class="flex flex-col items-center gap-2 px-6 py-6 md:px-8 md:py-8">
					{b.derContenido.map((linea) => {
						const precioSolo = /^€[\d.,]+$/.test(linea);
						if (precioSolo) {
							return (
								<p class="mb-0 font-display text-4xl font-semibold leading-none text-brand">{linea}</p>
							);
						}
						if (linea.includes('→')) {
							const [antes, despues] = linea.split('→');
							return (
								<p class="mb-0 text-brand/85">
									<s class="text-brand/60">{antes.trim()}</s>
									{' → '}
									{despues.trim()}
								</p>
							);
						}
						return <p class="mb-0 text-brand/85">{linea}</p>;
					})}
					<a
						href="https://go.facultadlalangue.com/entrevista-directa"
						class="mt-4 inline-block rounded-md bg-brand px-8 py-3 font-display text-base font-semibold uppercase tracking-wide text-white transition-colors hover:bg-brand-dark hover:no-underline"
					>
						Agendar entrevista de admisión
					</a>
				</div>
			</div>
		</div>
	</section>
)}

