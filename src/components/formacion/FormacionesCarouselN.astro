---
import 'swiper/css';
import 'swiper/css/a11y';
import { link } from '../../lib/link.ts';
import IconoChevron from '../IconoChevron.astro';

import { carruselFormaciones } from '../../data/home';
import Rico from './Rico.astro';

const { items, titulo, kicker, intro, id } = carruselFormaciones;

// Keep full copies on both sides before Swiper starts. The extra loop buffer
// lets Swiper recycle offscreen slides without exposing either end of the track.
const slides = [...items, ...items, ...items];
---

<section id={id} class="formaciones-carousel-n full-bleed mt-14 overflow-clip bg-[#5b11331a] px-2.5 py-5 font-heading text-base leading-[1.7] text-[#1e1e1e] md:p-[50px] [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-4 [&_:focus-visible]:outline-[#8c1c3f]" aria-labelledby="formaciones-n-titulo">
  <div class="mx-auto flex max-w-[1140px] flex-col gap-5 max-[1024px]:max-w-[1024px]">
    <header class="p-2.5">
      {kicker && <p class="m-0 mb-2 text-center text-xs font-semibold uppercase tracking-widest text-accent md:text-left">{kicker}</p>}
      <h2 id="formaciones-n-titulo" class="m-0 mb-5 text-center font-display text-[38px] font-bold uppercase leading-[1.2] tracking-[-1px] text-[#8c1c3f] md:text-left md:text-5xl md:leading-[72px]">{titulo}</h2>
      {(Array.isArray(intro) ? intro : intro ? [intro] : []).map((parrafo) => (
        <Rico texto={parrafo} class="m-0 mb-[33px] w-full leading-[1.8] md:mb-0 md:w-4/5 md:leading-[1.7]" />
      ))}
    </header>
    <formaciones-carousel-n data-course-count={items.length} class="relative block min-w-0 p-2.5">
      <div class="e-n-carousel swiper offset-both overflow-visible! px-[50px]! [clip-path:inset(0_-200%_0_-200%)] [&:not(.swiper-initialized)_.swiper-wrapper]:gap-2.5 [&:not(.swiper-initialized)_.swiper-slide]:w-full! md:[&:not(.swiper-initialized)_.swiper-slide]:w-[calc((100%_-_10px)/2)]!" role="region" aria-roledescription="carrusel" aria-label={titulo} tabindex="0">
        <div class="swiper-wrapper">
          {slides.map((formacion, index) => (
            <article class="swiper-slide h-auto! shrink-0 p-2.5" role="group" aria-roledescription="diapositiva" data-course-index={index % items.length} aria-label={`${index % items.length + 1} de ${items.length}`}>
              <div class="flex flex-col gap-5 p-2.5">
                <a class="group block" href={link(formacion.href ?? '#')} tabindex="-1" aria-hidden="true">
                  {formacion.imagen && <img src={link(formacion.imagen)} alt={formacion.alt ?? formacion.titulo} width="1024" height="576" loading="eager" decoding="async" class="block rounded-xl aspect-video h-auto w-full transition-transform duration-300 group-hover:scale-110 motion-reduce:transform-none motion-reduce:transition-none" />}
                </a>
                <h3 class="m-0 font-display text-lg font-bold uppercase leading-[25px] tracking-[-.5px] md:text-xl"><a class="text-[#5b1133] transition-colors duration-1000 hover:text-[#8c1c3f] hover:no-underline focus:text-[#8c1c3f] focus:no-underline motion-reduce:transition-none" href={link(formacion.href ?? '#')}>{formacion.titulo}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
      <button data-carousel-prev class="absolute left-0 top-1/2 z-10 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/90 p-0 text-white" type="button" aria-label="Formación anterior">
        <IconoChevron class="size-6 rotate-90" />
      </button>
      <button data-carousel-next class="absolute right-0 top-1/2 z-10 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/90 p-0 text-white" type="button" aria-label="Formación siguiente">
        <IconoChevron class="size-6 -rotate-90" />
      </button>
      <button class="formaciones-n-pause sr-only absolute focus-visible:not-sr-only focus-visible:absolute focus-visible:right-2.5 focus-visible:bottom-0 focus-visible:z-2 focus-visible:bg-[#5b1133] focus-visible:px-3 focus-visible:py-2 focus-visible:[font:inherit] focus-visible:text-white" type="button" aria-pressed="false">Pausar carrusel</button>
    </formaciones-carousel-n>
    <a class="self-center rounded-[3px] bg-[#5b1133] px-8 py-4 text-center text-base font-extrabold uppercase leading-none text-[#fffafa] transition-colors duration-300 hover:bg-[#65002a] hover:no-underline focus:bg-[#65002a] focus:no-underline motion-reduce:transition-none" href="https://go.facultadlalangue.com/entrevista-directa">Postulate para una beca</a>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { A11y, Autoplay, Keyboard, Navigation } from 'swiper/modules';

  class FormacionesCarouselN extends HTMLElement {
    private swiper?: Swiper;
    private events?: AbortController;

    connectedCallback() {
      if (this.swiper) return;
      const carousel = this.querySelector<HTMLElement>('.swiper');
      const pause = this.querySelector<HTMLButtonElement>('.formaciones-n-pause');
      const previous = this.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!carousel || !pause || !previous || !next) return;
      this.events = new AbortController();
      const { signal } = this.events;
      const courseCount = Number(this.dataset.courseCount);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let userPaused = reducedMotion.matches;
      const updatePause = () => {
        pause.setAttribute('aria-pressed', String(userPaused));
        pause.textContent = userPaused ? 'Reanudar carrusel' : 'Pausar carrusel';
      };
      this.swiper = new Swiper(carousel, {
        modules: [A11y, Autoplay, Keyboard, Navigation],
        slidesPerView: 1,
        slidesPerGroup: 1,
        spaceBetween: 10,
        loop: true,
        // Start in the middle copy, retaining the selected third course.
        initialSlide: courseCount + 2,
        loopAdditionalSlides: courseCount,
        speed: reducedMotion.matches ? 0 : 2000,
        grabCursor: true,
        breakpoints: { 768: { slidesPerView: 2 } },
        autoplay: {
          delay: 1000,
          pauseOnMouseEnter: true,
          disableOnInteraction: true,
        },
        keyboard: { enabled: true, onlyInViewport: true },
        navigation: { prevEl: previous, nextEl: next, addIcons: false },
        a11y: {
          prevSlideMessage: 'Formación anterior',
          nextSlideMessage: 'Formación siguiente',
          containerRoleDescriptionMessage: 'carrusel',
          itemRoleDescriptionMessage: 'diapositiva',
          // Keep the server-rendered labels based on the six unique courses.
          slideLabelMessage: '',
        },
      });
      if (userPaused) this.swiper.autoplay.stop();
      updatePause();
      pause.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) this.swiper?.autoplay.stop();
        else this.swiper?.autoplay.start();
        updatePause();
      }, { signal });
      carousel.addEventListener('focusin', () => this.swiper?.autoplay.stop(), { signal });
      reducedMotion.addEventListener('change', (event) => {
        userPaused = event.matches;
        if (this.swiper) {
          this.swiper.params.speed = event.matches ? 0 : 2000;
          if (userPaused) this.swiper.autoplay.stop();
        }
        updatePause();
      }, { signal });
    }

    disconnectedCallback() {
      this.events?.abort();
      this.swiper?.destroy(true, true);
      this.swiper = undefined;
    }
  }

  if (!customElements.get('formaciones-carousel-n')) {
    customElements.define('formaciones-carousel-n', FormacionesCarouselN);
  }
</script>
