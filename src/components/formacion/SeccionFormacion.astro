---
/**
 * SeccionFormacion — un grupo de bloques del layout 'secciones' (el de TODAS
 * las páginas de formación).
 *
 * Cada entrada de `formacion.secciones` (tipo SeccionPagina = { bloques }) se
 * renderiza como UN SOLO <section> apilado. Las secciones NO llevan márgenes
 * entre sí: cada una paga su propio padding vertical (y su fondo cuando
 * corresponde) y los bloques internos solo guardan ritmo entre ellos (el
 * contenedor anula el margen superior del primer bloque con
 * `[&>:first-child]:mt-0`).
 *
 * Medida única: todos los contenedores de contenido usan el MISMO margen
 * izquierdo/derecho que el hero (clase .contenedor, 1152px). Los únicos
 * bloques que se escapan son los que renderizan su propia banda de color
 * full-width (stats, cta, articula, modulos, admision) y Certificación.
 *
 * Regla de oro: si el grupo resuelve a UN SOLO bloque full-bleed (stats, cta,
 * articula, modulos, certificacion o admision — bandas de ancho completo que
 * ya poseen su propia sección con fondo y padding), ese bloque se renderiza
 * DIRECTAMENTE para que él mismo sea el <section>. En el layout 'secciones'
 * esos bloques conservan su fondo y su padding.
 */
import {
	componentePorId,
	type BloquePagina,
	type Bloque,
	type SeccionPagina,
} from '../../data/componentes';
import BloqueRender from './BloqueRender.astro';

interface Props {
	entrada: SeccionPagina;
}

const { entrada } = Astro.props;

/** Bloques que renderizan SU PROPIA <section> en el layout 'secciones' y por
 *  eso, cuando son el único bloque del grupo, se renderizan directos sin
 *  envolver: bandas full-width (stats, cta, articula, modulos, admision,
 *  planes) y Certificación. Solo existen dos anchos: la banda full-width (que paga su
 *  propio fondo) o la sección con el margen del hero (.contenedor). */
const SECCION_PROPA = new Set(['stats', 'cta', 'articula', 'modulos', 'certificacion', 'admision', 'planes']);

/** Expande cada cita a un componente común (c('NOMBRE')) a sus bloques reales,
 *  para decidir el envoltorio sobre la lista ya aplanada. */
const bloques = entrada.bloques.flatMap((b): Bloque[] => {
	if (b.tipo === 'componente') {
		const cc = componentePorId[b.nombre];
		return cc ? cc.bloques : [];
	}
	return [b];
});

const unico = bloques.length === 1 ? bloques[0] : undefined;
const solo = !!unico && SECCION_PROPA.has(unico.tipo);
// El grupo "Es para ti si / No es para ti si" lleva su propia banda de color
// SÓLIDA de la paleta (fondo vino profundo) para contrastar con el blanco del
// resto de la página; las tarjetas claras del bloque se destacan sobre ella.
const conFondoParaTi = bloques.some((b) => b.tipo === 'dirigido-a');
---

{solo && unico ? (
	<BloqueRender bloque={unico} layout="secciones" />
) : (
	<section class={`py-16 sm:py-20${conFondoParaTi ? ' bg-brand-dark' : ' py-14 sm:py-16'}`}>
		<div class="contenedor [&>:first-child]:mt-0">
			{bloques.map((b) => (
				<BloqueRender bloque={b} layout="secciones" />
			))}
		</div>
	</section>
)}