---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Tipografías: DM Sans (cuerpo), Montserrat (h1), Poppins (h2–h6), Roboto Condensed (menú) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600&family=Roboto+Condensed:wght@400;600&display=swap"
			rel="stylesheet"
		/>

		<!-- Paleta en vivo (selector en /roadmap → "Editor de paleta en vivo").
		     Al cargar cualquier página, se leen los colores guardados en
		     localStorage y se sobreescriben los tokens en :root, de modo que
		     el sitio entero (incluido el header y el isotipo) se repinta. -->
		<script is:inline>
			(() => {
				const KEY = 'lalangue-paleta';
				// Tokens de la paleta por defecto (los oficiales de global.css).
				// (El editor de /roadmap guarda cualquier token en localStorage;
				//  acá se aplican todos los que haya: la elección de tema repinta
				//  el sitio entero, incluido el isotipo del header y el footer.)
				const TOKENS = {
					brand: '#8c1c3f',
					'brand-dark': '#5b1133',
					'accent': '#d5673f',
					indigo: '#45426d',
					night: '#14141a',
					background: '#faf8f6',
					surface: '#f6f6f8',
					divider: '#e4e4ec',
					'ink': '#2b2b34',
					'ink-strong': '#14141a',
					muted: '#6f6f7c',
					dim: '#8e8e9c',
				};
				window.__LALANGUE_PALETA = { KEY, TOKENS };
				try {
					const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
					if (saved) {
						for (const [k, v] of Object.entries(saved)) {
							if (typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v)) {
								document.documentElement.style.setProperty(`--color-${k}`, v);
							}
						}
					}
				} catch (e) {
					/* paleta dañada: ignorar y usar defaults */
				}
				// Isotipo con colores propios, independientes de la paleta del
				// sitio. La elección se guarda en 'lalangue-iso' por el editor
				// de /roadmap:
				//   - 'active' (o sin clave): el isotipo sigue al tema del sitio
				//     (referencias a --color-brand/accent/indigo), como siempre.
				//   - una paleta específica: literales fijos, aunque después
				//     cambies el tema; todo el sitio usa esos colores.
				let iso = null;
				try {
					iso = JSON.parse(localStorage.getItem('lalangue-iso') || 'null');
				} catch (e) {
					iso = null;
				}
				if (iso && iso.pal && iso.pal !== 'active') {
					const hex = (v, fb) =>
						typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v) ? v : fb;
					document.documentElement.style.setProperty('--iso-c1', hex(iso.c1, '#8c1c3f'));
					document.documentElement.style.setProperty('--iso-c2', hex(iso.c2, '#d5673f'));
					document.documentElement.style.setProperty('--iso-c3', hex(iso.c3, '#45426d'));
				} else {
					document.documentElement.style.setProperty('--iso-c1', 'var(--color-brand)');
					document.documentElement.style.setProperty('--iso-c2', 'var(--color-accent)');
					document.documentElement.style.setProperty('--iso-c3', 'var(--color-indigo)');
				}
				// Logo del navbar: Isotipo (default) o Bandera. Se aplica como
				// data-logo-nav en <html> para que el CSS muestre el SVG que
				// corresponde (ver .logo-nav-* en global.css). El roadmap lo
				// cambia en vivo con la misma key.
				let logoNav = 'isotipo';
				try {
					if (localStorage.getItem('lalangue-logo-nav') === 'bandera') logoNav = 'bandera';
				} catch (e) {
					/* ignorar */
				}
				document.documentElement.dataset.logoNav = logoNav;
			})();
		</script>
	</head>
	{/* body como columna flex: el contenido crece (flex-1) para anclar el
	     footer al fondo cuando la página es corta (p. ej. el 404). */}
	<body class="flex min-h-screen flex-col bg-background text-ink">
		<Header />
		<div class="flex-1"><slot /></div>
		<Footer />
	</body>
</html>