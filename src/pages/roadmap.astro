									<select
										id={`iso-${slot.id}`}
										data-iso-slot={slot.id}
										class="w-full rounded-md border border-divider bg-white px-3 py-2 text-sm text-ink"
									>
										{/* Las opciones se cargan por JS desde la paleta
										    elegida para el isotipo (dropdown de arriba). */}
									</select>
								</div>
							</div>
						))
					}
					<div>
						<span class="text-sm font-medium text-ink-strong">
							Forma del logo en el navbar
						</span>
						<div class="mt-3 flex gap-2">
							<button
								type="button"
								data-logo-nav-btn="isotipo"
								aria-pressed="true"
								class="flex-1 rounded-md border px-3 py-1.5 text-sm font-semibold transition-colors"
							>
								Isotipo
							</button>
							<button
								type="button"
								data-logo-nav-btn="bandera"
								aria-pressed="false"
								class="flex-1 rounded-md border px-3 py-1.5 text-sm font-semibold transition-colors"
							>
								Bandera
							</button>
						</div>
					</div>
					<p class="text-xs leading-relaxed text-muted">
						Todo se repinta <strong>al instante</strong>: los isotipos del
						navbar y del header usan las variables CSS
						<code class="text-brand">--iso-c1/c2/c3</code>, así que al
						modificar los colores o la forma acá, el navbar y el sitio se
						actualizan en el momento (misma elección que la sección
						"Logo del navbar" de más abajo). En la bandera un solo
						isotipo se parte por franjas diagonales de color — vino a la
						izquierda, índigo al centro, accent a la derecha —
						reconstruido 1:1 desde el export plano de Inkscape
						(<code>docs/isologo_bandera.svg</code>).
					</p>
				</div>
			</div>
		</section>

		

		<!-- ================= Navbar — Logo y tamaño ================= -->
