---
/**
 * Página de formación (ruta dinámica de raíz).
 * Se genera una página por cada entrada de src/data/formaciones.ts, en la
 * URL definida por su `slug` (que coincide con la ruta citada en el menú).
 *
 * La página NO define contenido: declara los datos de la formación (encabezado
 * y meta, renderizados por HeroFormacion) y sus `secciones` — grupos de
 * bloques envueltos en seccion(...) — exclusivamente a través de los
 * componentes de render de src/components/formacion/. Cualquier cambio de
 * diseño se hace una sola vez en esos componentes y se propaga a todas las
 * páginas (fuente única de verdad).
 *
 * Layout único (el mismo en todas las formaciones), con dos medidas de ancho:
 *  - el hero (HeroFormacion) es una sección full-width con el mismo
 *    contenedor y tipografía que el hero del home; no tiene botón
 *    "Volver al inicio";
 *  - cada grupo de bloques se apila en su propio <section>, con el MISMO
 *    margen izquierdo/derecho que el hero (max-w-7xl), salvo los bloques
 *    full-width (stats, cta, articula, modulos, admision) que renderizan su
 *    propia banda de color, y Certificación.
 */
import Layout from '../layouts/Layout.astro';
import { formaciones } from '../data/formaciones';
import type { SeccionPagina } from '../data/componentes';
import SeccionFormacion from '../components/formacion/SeccionFormacion.astro';
import HeroFormacion from '../components/formacion/HeroFormacion.astro';

export function getStaticPaths() {
	return formaciones.map((f) => ({
		params: { slug: f.slug },
		props: { formacion: f },
	}));
}

interface Props {
	formacion: (typeof formaciones)[number];
}
const { formacion } = Astro.props;

const secciones: SeccionPagina[] = formacion.secciones;
---

<Layout title={`${formacion.titulo} — Facultad Lalangue`}>
	<main class="flex-1">
		<HeroFormacion formacion={formacion} />

		<!-- Contenido: secciones agrupadas, apiladas sin márgenes entre sí -->
		{secciones.map((entrada) => (
			<SeccionFormacion entrada={entrada} />
		))}
	</main>
</Layout>