					</div>
					{
						isotipoSlots.map((slot) => (
							<div>
								<div class="flex items-baseline gap-2">
									<span class="text-sm font-medium text-ink-strong">{slot.label}</span>
									<span class="text-xs text-muted">{slot.original}</span>
