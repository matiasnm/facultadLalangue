		'<button type="button" class="inline-flex rounded-lg p-2 text-accent"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg></button>',
	summary:
		'<div class="max-w-xs border-b border-divider/40"><div class="flex items-center justify-between py-3 font-display text-base font-normal uppercase tracking-wide text-night"><span>Conócenos</span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5 text-accent" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></div></div>',
	msubmenu:
		'<a href="#" class="inline-block py-2 font-display text-base font-normal uppercase tracking-wide text-night/80 hover:text-accent">Facultad</a>',
	mlink:
		'<a href="#" class="inline-block py-3 font-display text-base font-normal uppercase tracking-wide text-night hover:text-accent">Mediateca</a>',
};
---

<Layout title="Roadmap de estilos — Facultad LaLagüe">
	<main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
		<a href={base || '/'} class="text-sm text-brand hover:underline">← Volver al sitio</a>
		<h1 class="mt-6">Roadmap de estilos</h1>
		<p class="text-ink/80">
			Especificación completa de la paleta, los estilos globales y del menú
			de <code>facultad-lalague</code>. Última actualización: {lastUpdated}.
		</p>
		<p class="mt-6">
			<a
				href={link('/textos/')}
				class="inline-flex items-center gap-1 rounded-md border border-divider bg-white px-3 py-1.5 text-sm font-semibold text-brand transition-colors hover:border-brand hover:no-underline"
			>
				Inventario de todos los textos del sitio →
			</a>
		</p>

		<!-- ================= Editor de paleta en vivo ================= -->
		<section class="mt-12 rounded-xl border-2 border-dashed border-accent/50 bg-surface p-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<p class="text-lg font-semibold text-night">Editor de paleta en vivo</p>
					<p class="mt-1 text-sm text-ink/70">
						Elegí un <em>tema</em>: las candidatas clásicas (Actual y las
						propuestas A–D, que mantienen la marca vino) más dos duplas
						<strong>rojo + verde</strong> construidas con la escala original
						(bordeaux noche, verde petróleo, cereza, pacífico y marfil).
						También podés afinar cada color manualmente. El cambio se aplica
						en el momento a todo el sitio —y a este roadmap— y se guarda en
						tu navegador (localStorage). Usá <em>Restaurar</em> para volver
						a los colores oficiales.
					</p>
				</div>
				<button
					id="palette-reset"
					type="button"
					class="rounded-md border border-divider bg-white px-4 py-2 text-sm font-semibold text-night transition-colors hover:border-brand hover:text-brand"
				>
					Restaurar colores default
				</button>
			</div>

			<!-- Selector de tema (paleta) -->
			<p class="mt-6 text-xs font-semibold uppercase tracking-widest text-muted">Tema</p>
			<div
				id="roadmap-palette-grid"
				class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5"
			></div>

			<!-- Afinar por token -->
			<div id="palette-pickers" class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-5">
				<p class="col-span-full text-xs font-semibold uppercase tracking-widest text-muted">
					Marca y acentos
				</p>
				{/* brand, accent, indigo, night */}
				{
					['brand', 'accent', 'indigo', 'night'].map((t) => (
						<div class="flex items-center gap-3 rounded-lg border border-divider bg-white p-3">
							<input
								type="color"
								data-palette-token={t}
								class="h-9 w-9 cursor-pointer rounded border border-divider bg-white p-0"
							/>
							<div class="min-w-0">
								<p class="text-xs font-semibold text-ink-strong">{t === 'brand' ? 'Marca' : t === 'accent' ? 'Acento' : t === 'indigo' ? 'Índigo' : t === 'night' ? 'Noche' : t}</p>
								<p class="truncate font-mono text-[0.6875rem] text-muted">--color-{t}</p>
							</div>
						</div>
					))
				}

				<p class="col-span-full mt-2 text-xs font-semibold uppercase tracking-widest text-muted">
					Neutros y superficies
				</p>
				{
					['background', 'surface', 'divider', 'ink', 'muted'].map((t) => (
						<div class="flex items-center gap-3 rounded-lg border border-divider bg-white p-3">
							<input
								type="color"
								data-palette-token={t}
								class="h-9 w-9 cursor-pointer rounded border border-divider bg-white p-0"
							/>
							<div class="min-w-0">
								<p class="text-xs font-semibold text-ink-strong">{t}</p>
								<p class="truncate font-mono text-[0.6875rem] text-muted">--color-{t}</p>
							</div>
						</div>
					))
				}
			</div>

			<script
				define:vars={{
					paletasData: paletas,
					dfltTokens: defaultTokens,
				}}
			>
				const boot = () => {
					// ── Estado compartido: lectura/escritura de la paleta ──────────
					const { KEY } = window.__LALANGUE_PALETA;
					const DEFAULTS = dfltTokens;
					const PALETAS = paletasData;

					const $ = (id) => document.getElementById(id);
					const readState = () => {
						try { return JSON.parse(localStorage.getItem(KEY) || 'null') || {}; } catch (e) { return {}; }
					};
					const writeState = (s) => {
						try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) { /* ignorar */ }
					};
					const applyTokens = (state) => {
						for (const [k, v] of Object.entries(state)) {
							if (typeof v === 'string' && /^#[0-9a-f]{6}$/i.test(v)) {
								document.documentElement.style.setProperty(`--color-${k}`, v);
							}
						}
					};
					// Tema activo = la paleta cuyo `brand` Y `accent` coinciden
					// con lo guardado (varias clásicas comparten la marca vino).
					// Si no hay paleta (default o ajustes manuales) → null.
					const findActive = (state) =>
						PALETAS.find(
							(p) =>
								p.tokens['brand'] === state['brand'] &&
								p.tokens['accent'] === state['accent'],
						) || null;

					// ── Tarjetas de temas ──────────────────────────────────────────
					const grid = $('roadmap-palette-grid');
					const swatchChip = (hex, nombre) => {
						const chip = document.createElement('span');
						chip.title = `${nombre} ${hex}`;
						chip.className = 'h-7 w-7 rounded-full shadow-[inset_0_0_0_1px_rgba(20,20,26,0.12)]';
						chip.style.background = hex;
						return chip;
					};
					const card = (p, isActive) => {
						const el = document.createElement('button');
						el.type = 'button';
						el.className =
							'group flex flex-col rounded-xl border p-4 text-left transition-all ' +
							(isActive
								? 'border-brand bg-brand/10 shadow-[0_0_0_1px_var(--color-brand)]'
								: 'border-divider bg-white hover:border-brand/40 hover:shadow-md');
						const head = document.createElement('div');
						head.className = 'flex items-center justify-between gap-2';
						const name = document.createElement('span');
						name.className = 'text-sm font-semibold text-ink-strong';
						name.textContent = p.nombre;
						head.appendChild(name);
						if (isActive) {
							const tag = document.createElement('span');
							tag.className =
								'rounded-full bg-brand px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-white';
							tag.textContent = 'Activa';
							head.appendChild(tag);
						}
						el.appendChild(head);
						const desc = document.createElement('p');
						desc.className = 'mt-1 text-[0.6875rem] leading-relaxed text-ink/70';
						desc.textContent = p.desc;
						el.appendChild(desc);
						const chips = document.createElement('div');
						chips.className = 'mt-3 flex items-center gap-1.5';
						p.swatches.forEach((s) => chips.appendChild(swatchChip(s.hex, s.nombre)));
						el.appendChild(chips);
						const hex = document.createElement('p');
						hex.className = 'mt-2 truncate font-mono text-[0.625rem] text-muted';
						hex.textContent = p.swatches.map((s) => s.hex).join(' · ');
						el.appendChild(hex);
						el.addEventListener('click', () => applyPalette(p));
						return el;
					};
					const renderCards = () => {
						const active = findActive(readState());
						grid.replaceChildren(
							...PALETAS.map((p) => card(p, active !== null && active.id === p.id)),
						);
					};

					// ── Aplicar / restaurar ────────────────────────────────────────
					const applyPalette = (p) => {
						// El fondo se elige aparte (sección "Color de fondo"): la
						// paleta no lo impone. Por legibilidad el fondo se mantiene
						// siempre en blancos próximos al blanco puro (los marfiles
						// de las duplas solo aparecen como swatches, no como fondo).
						const curBg = readState()['background'] || DEFAULTS['background'];
						const state = { ...DEFAULTS, ...p.tokens, background: curBg };
						writeState(state);
						applyTokens(state);
						syncAll();
					};
					const resetPalette = () => {
						try { localStorage.removeItem(KEY); } catch (e) { /* ignorar */ }
						applyTokens(DEFAULTS);
						syncAll();
					};

					// ── Inputs por token (ajuste fino) ─────────────────────────────
					const inputs = Array.from(document.querySelectorAll('[data-palette-token]'));
					const syncInputs = () => {
						const saved = readState();
						inputs.forEach((el) => {
							const t = el.dataset.paletteToken;
							el.value = saved[t] || DEFAULTS[t];
						});
					};
					inputs.forEach((el) => {
						const t = el.dataset.paletteToken;
						el.addEventListener('input', () => {
							document.documentElement.style.setProperty(`--color-${t}`, el.value);
						});
						el.addEventListener('change', () => {
							const s = readState();
							s[t] = el.value;
							writeState(s);
							// al ajustar a mano, el tema deja de estar "activo"
							renderCards();
							// y el isotipo de preview vuelve a pintarse con las
							// variables CSS (para reflejar el token ajustado).
							document.querySelectorAll('#isotipo-live .isotipo').forEach((iso) => {
								isoSelects.forEach((sel) =>
									iso.style.removeProperty(`--iso-${sel.dataset.isoSlot}`),
								);
							});
						});
					});

					// ── Isotipo: selects de color por paleta activa ────────────────
					const isoSelects = Array.from(document.querySelectorAll('[data-iso-slot]'));
					const slotDefault = (slot) => {
						const s = readState();
						if (slot === 'c1') return s['brand'] || DEFAULTS['brand'];
						if (slot === 'c2') return s['accent'] || DEFAULTS['accent'];
						return s['indigo'] || DEFAULTS['indigo'];
					};
					const applyIsoFromSelects = () => {
						document.querySelectorAll('#isotipo-live .isotipo').forEach((iso) => {
							isoSelects.forEach((sel) => {
								iso.style.setProperty(`--iso-${sel.dataset.isoSlot}`, sel.value);
							});
						});
					};
					const syncIsoSelects = () => {
						const active = findActive(readState());
						const logos = active ? active.logos : DEFAULTS_LOGOS;
						isoSelects.forEach((sel) => {
							const slot = sel.dataset.isoSlot;
							const cur = slotDefault(slot);
							sel.replaceChildren(
								...logos.map((o) => {
									const opt = document.createElement('option');
									opt.value = o.hex;
									opt.textContent = `${o.hex} — ${o.nombre}`;
									if (o.hex === cur) opt.selected = true;
									return opt;
								}),
							);
							if (!logos.some((o) => o.hex === cur)) sel.selectedIndex = 0;
						});
						applyIsoFromSelects();
					};
					isoSelects.forEach((sel) => {
						sel.addEventListener('change', applyIsoFromSelects);
					});

					// ── Fondo: opciones por paleta activa ─────────────────────────
					const bgSelect = $('bg-picker');
					const bgPreview = $('bg-preview');
					const applyBg = (hex, persist = true) => {
						document.documentElement.style.setProperty('--color-background', hex);
						if (bgPreview) bgPreview.style.backgroundColor = hex;
						if (persist) {
							const s = readState();
							s['background'] = hex;
							writeState(s);
						}
					};
					const syncBg = () => {
						if (!bgSelect) return;
						const cur = readState()['background'] || DEFAULTS['background'];
						bgSelect.replaceChildren(
							...FONDO_WHITES.map((o) => {
								const opt = document.createElement('option');
								opt.value = o.hex;
								opt.textContent = o.nombre;
								if (o.hex === cur) opt.selected = true;
								return opt;
							}),
						);
						applyBg(bgSelect.value, false);
					};
					if (bgSelect) {
						bgSelect.addEventListener('change', () => applyBg(bgSelect.value));
					}

					// ── Sección "Paleta de colores": swatches del tema activo ──────
					const deck = $('palette-deck');
					const deckName = $('palette-deck-name');
					const deckDesc = $('palette-deck-desc');
					const swatchCard = (s) => {
						const el = document.createElement('div');
						el.className =
							'relative flex h-[104px] w-[112px] flex-col items-center justify-end rounded-[10px] p-2 text-center text-[11px] text-white';
						el.style.background = s.hex;
						const hexEl = document.createElement('span');
						hexEl.className = 'font-mono';
						hexEl.textContent = s.hex;
						const nameEl = document.createElement('span');
						nameEl.className = 'mt-0.5 text-[10px] opacity-80';
						nameEl.textContent = s.nombre;
						el.appendChild(hexEl);
						el.appendChild(nameEl);
						return el;
					};
					const renderDeck = () => {
						const active = findActive(readState());
						if (deckName) {
							deckName.textContent = active
								? `${active.nombre} (tema activo)`
								: 'Colores oficiales (tema default)';
						}
						if (deckDesc) {
							deckDesc.textContent = active
								? active.desc
								: 'La paleta vigente en global.css: vino + naranja cálido y la escala de vino a azul petróleo. Elegí un tema arriba para cambiar estos swatches.';
						}
						if (deck) {
							deck.replaceChildren(
								...(active ? active.swatches : DEFAULTS_SWATCHES).map(swatchCard),
							);
						}
					};

					// ── Sincronización completa ────────────────────────────────────
					const syncAll = () => {
						syncInputs();
						renderCards();
						syncBg();
						syncIsoSelects();
						renderDeck();
					};

					// Opciones por defecto para selects cuando está el tema oficial.
					const DEFAULTS_LOGOS = [
						{ hex: '#8c1c3f', nombre: 'Vino' },
						{ hex: '#5b1133', nombre: 'Vino profundo' },
						{ hex: '#d5673f', nombre: 'Naranja cálido' },
						{ hex: '#7b2a5a', nombre: 'Malbec' },
						{ hex: '#61386a', nombre: 'Ciruela' },
						{ hex: '#45426d', nombre: 'Índigo' },
						{ hex: '#324765', nombre: 'Azul acero' },
						{ hex: '#2f4858', nombre: 'Azul petróleo' },
						{ hex: '#14141a', nombre: 'Negro noche' },
						{ hex: '#454560', nombre: 'Gris pizarra' },
						{ hex: '#8e8e9c', nombre: 'Gris perla' },
					];
					// Blancos de fondo FIJOS, independientes de la paleta: el fondo
					// se elige por legibilidad y se mantiene cerca del blanco puro.
					const FONDO_WHITES = [
						{ hex: '#ffffff', nombre: 'Blanco puro' },
						{ hex: '#faf8f6', nombre: 'Humo cálido' },
						{ hex: '#f7f6f8', nombre: 'Humo neutro' },
						{ hex: '#f5f4f6', nombre: 'Perla fría' },
						{ hex: '#f6f1f2', nombre: 'Vaina clara' },
					];
					const DEFAULTS_SWATCHES = [
						{ hex: '#8c1c3f', nombre: 'Vino' },
						{ hex: '#5b1133', nombre: 'Vino profundo' },
						{ hex: '#d5673f', nombre: 'Naranja cálido' },
						{ hex: '#7b2a5a', nombre: 'Malbec' },
						{ hex: '#61386a', nombre: 'Ciruela' },
						{ hex: '#45426d', nombre: 'Índigo' },
						{ hex: '#324765', nombre: 'Azul acero' },
						{ hex: '#2f4858', nombre: 'Azul petróleo' },
						{ hex: '#f6f6f8', nombre: 'Humo' },
						{ hex: '#faf8f6', nombre: 'Humo cálido' },
					];

					$('palette-reset').addEventListener('click', resetPalette);

					// Inicialización: se corre sobre DOMContentLoaded porque las
					// secciones de Isotipo y Color de fondo van más abajo en el
					// HTML (los selects se llenan ahí, y este script se ejecuta
					// durante el parseo, antes de que existan).
					syncAll();
				};
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', boot);
				} else {
					boot();
				}
			</script>
		</section>

		<!-- ================= Color de fondo ================= -->
		<section class="mt-16">
			<p class="text-xs font-semibold uppercase tracking-widest text-accent">Fondo</p>
			<h2>Color de fondo</h2>
			<p class="mt-2 max-w-2xl text-ink/80">
				El fondo se elige <strong>aparte de la paleta</strong>: la paleta
				cambia marca, acento y textos, pero el fondo se mantiene siempre en
				blancos próximos al blanco puro para preservar la legibilidad (un
				fondo muy teñido, como los marfiles de las duplas, cansa la
				lectura). Elegí una opción: se guarda en tu navegador y se repinta
				en todas las páginas.
			</p>

			<div
				class="mt-8 grid gap-8 overflow-hidden rounded-xl border border-divider/30 bg-white p-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]"
			>
				<!-- Preview: el fondo sobre el body real -->
				<div class="flex flex-col items-center justify-center gap-4 rounded-xl p-10" id="bg-preview">
					<p class="text-sm text-ink/80">
						Esta tarjeta ilustra el fondo del sitio. Las superficies
						<span class="inline-block h-3 w-3 translate-y-0.5 rounded-sm align-middle" style="background:var(--color-surface)"></span>
						y el blanco de las cards siguen iguales para que el contraste
						se mantenga.
					</p>
				</div>

				<!-- Selector -->
				<div class="flex flex-col justify-center gap-5">
					<div>
						<label class="sr-only" for="bg-picker">Color de fondo</label>
						<select
							id="bg-picker"
							data-bg-slot
							class="w-full rounded-md border border-divider bg-white px-3 py-2 text-sm text-ink"
						>
							{/* Blancos fijos, independientes de la paleta (ver
							    FONDO_WHITES en el script del editor). */}
						</select>
					</div>
					<p class="text-xs leading-relaxed text-muted">
						Blancos de fondo <strong>fijos</strong>, independientes de la
						paleta elegida: blanco puro y los cuatro tonos neutros del
						sitio (humo cálido, humo neutro, perla fría y vaina clara).
						Las superficies (<code class="text-brand">--color-surface</code>)
						y el blanco de las cards no cambian.
					</p>
				</div>
			</div>
		</section>

		<!-- ================= Paleta de colores ================= -->
		<section class="mt-16">
			<h2>Paleta de colores</h2>
			<p class="text-ink/80">
				Este bloque muestra los swatches del <strong>tema activo</strong>:
				cambian al instante cuando elegís una paleta en el editor de arriba.
				Cada tema lleva su propia marca (brand), su acento y su escala de
				neutros, y repinta todo el sitio (incluido el isotipo del header).
			</p>
			<div class="mt-8 rounded-xl border border-divider/30 bg-surface p-6">
				<p class="text-xs font-medium uppercase tracking-widest text-muted" id="palette-deck-name">
					Tema —
				</p>
				<p class="mt-1 text-sm text-ink/70" id="palette-deck-desc">—</p>
				<div id="palette-deck" class="mt-4 flex flex-wrap gap-2.5"></div>
				<p class="mt-6 border-t border-divider/60 pt-4 text-xs leading-relaxed text-muted">
					Los detalles finos (variación entre brand y brand-dark, neutros
					de texto, acento e índigo) se eligen desde el editor de arriba.
				</p>
			</div>
		</section>

		<!-- ================= Isotipo ================= -->
		<section class="mt-16">
			<h2>Isotipo</h2>
			<p class="text-ink/80">
				<code>docs/logo_indigo.svg</code> — el isotipo (solo el símbolo,
				sin texto) tiene 3 colores (vino, naranja e índigo). Elegí para
				cada uno de ellos cualquiera de los colores disponibles de la
				paleta activa (los que ves hecho en el editor de arriba) y el
				recolor se aplica en vivo:
			</p>

			<div
				class="mt-8 grid gap-8 overflow-hidden rounded-xl border border-divider/30 bg-surface p-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]"
			>
				<!-- Preview del isotipo sobre blanco: el clásico + la bandera -->
				<div
					id="isotipo-live"
					class="flex flex-wrap items-center justify-center gap-10 rounded-xl bg-white p-10"
				>
					<div class="flex flex-col items-center gap-3">
						<Isotipo
							class="h-40 w-auto"
							wine="var(--color-brand)"
							accent="var(--color-accent)"
							indigo="var(--color-indigo)"
						/>
						<span class="text-xs text-muted">Isotipo</span>
					</div>
					<div class="flex flex-col items-center gap-3">
						<IsotipoBandera
							class="h-40 w-auto"
							wine="var(--color-brand)"
							accent="var(--color-accent)"
							indigo="var(--color-indigo)"
						/>
						<span class="text-xs text-muted">Bandera</span>
					</div>
				</div>

				<!-- Pickers de color -->
				<div class="flex flex-col justify-center gap-5">
					{
						isotipoSlots.map((slot) => (
							<div>
								<div class="flex items-baseline gap-2">
									<span class="text-sm font-medium text-ink-strong">{slot.label}</span>
									<span class="text-xs text-muted">{slot.original}</span>
								</div>
								<div class="mt-2">
									<label class="sr-only" for={`iso-${slot.id}`}>
										{slot.label}
									</label>
									<select
										id={`iso-${slot.id}`}
										data-iso-slot={slot.id}
										class="w-full rounded-md border border-divider bg-white px-3 py-2 text-sm text-ink"
									>
										{/* Las opciones se cargan por JS desde la paleta activa. */}
									</select>
								</div>
							</div>
						))
					}
					<p class="text-xs leading-relaxed text-muted">
						Las opciones de estos selects son las de la paleta activa
						(campo <code class="text-brand">logos</code> de cada tema).
						Ambos isotipos se repintan en el momento: los tres grupos
						del SVG se pintan con las variables CSS seleccionadas
						(<code class="text-brand">--iso-c1/c2/c3</code>). En la
						bandera un solo isotipo se parte por franjas diagonales
						de color — vino a la izquierda, índigo al centro, accent
						a la derecha — reconstruido 1:1 desde el export plano de
						Inkscape (<code>docs/isologo_bandera.svg</code>).
					</p>
				</div>
			</div>
		</section>

		

		<!-- ================= Navbar — Logo y tamaño ================= -->
		<section class="mt-16">
			<p class="text-xs font-semibold uppercase tracking-widest text-accent">Navbar</p>
			<h2>Logo del navbar</h2>
			<p class="mt-2 max-w-2xl text-ink/80">
				Elegí qué isotipo se muestra en la barra de navegación — el clásico
				o la bandera (el mismo símbolo partido en franjas diagonales) — y qué
				altura tiene dentro del header. La variante se guarda como
				<code class="text-brand">lalangue-logo-nav</code> y la altura como
				<code class="text-brand">--logo-h</code>; se repintan al instante.
			</p>

			<div
				class="mt-8 grid gap-8 overflow-hidden rounded-xl border border-divider/30 bg-white p-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]"
			>
				<!-- Vista previa: el navbar real a escala (ambos isotipos; el CSS
				     muestra el que corresponde según data-logo-nav). -->
				<div class="flex items-center rounded-xl border border-divider/30 bg-surface p-4">
					<a
						href={base || '/'}
						class="flex shrink-0 items-center gap-4 hover:no-underline"
						aria-label="Vista previa del logo"
					>
						<Isotipo
							class="logo-nav-plain h-[calc(var(--spacing)*var(--logo-h,11))] w-auto"
							wine="var(--color-brand)"
							accent="var(--color-accent)"
							indigo="var(--color-indigo)"
						/>
						<IsotipoBandera
							class="logo-nav-bandera h-[calc(var(--spacing)*var(--logo-h,11))] w-auto"
							wine="var(--color-brand)"
							accent="var(--color-accent)"
							indigo="var(--color-indigo)"
						/>
						<span class="flex flex-col leading-none">
							<span
								class="flex w-full justify-between font-heading text-[0.8203rem] font-medium leading-none text-night/70"
							>
								<span>F</span><span>A</span><span>C</span><span>U</span
								><span>L</span><span>T</span><span>A</span><span>D</span>
							</span>
							<span
								class="-ml-[0.05em] font-heading text-[1.2891rem] font-semibold leading-none text-night"
							>
								Lalangue
							</span>
						</span>
					</a>
				</div>

				<!-- Controles -->
				<div class="flex flex-col justify-center gap-5">
					<div>
						<span class="text-sm font-medium text-ink-strong">Variante del isotipo</span>
						<div class="mt-3 flex gap-2">
							<button
								type="button"
								data-logo-nav-btn="isotipo"
								aria-pressed="true"
								class="flex-1 rounded-md border px-3 py-1.5 text-sm font-semibold transition-colors"
							>
								Isotipo
							</button>
							<button
								type="button"
								data-logo-nav-btn="bandera"
								aria-pressed="false"
								class="flex-1 rounded-md border px-3 py-1.5 text-sm font-semibold transition-colors"
							>
								Bandera
							</button>
						</div>
					</div>
					<div>
						<label for="logo-h-range" class="text-sm font-medium text-ink-strong">
							Altura del logo
						</label>
						<div class="mt-3 flex items-center gap-4">
							<input
								id="logo-h-range"
								type="range"
								min="8"
								max="24"
								step="1"
								class="w-full accent-[var(--color-accent)]"
							/>
							<input
								id="logo-h-number"
								type="number"
								min="8"
								max="24"
								step="1"
								class="w-16 rounded-md border border-divider bg-white px-2 py-1 text-center text-sm text-ink"
							/>
						</div>
					</div>
					<p class="text-xs leading-relaxed text-muted">
						<strong>Isotipo</strong> es el logo actual; la
						<strong>bandera</strong> lo parte en franjas diagonales
						(<code>docs/isologo_bandera.svg</code>). <strong>14</strong>
						fue la altura que te gustó al probar. Mínimo 8, máximo 24.
					</p>
				</div>
			</div>

			<script>
				const NAV_KEY = 'lalangue-logo-nav';
				const btn = (v) => document.querySelector(`[data-logo-nav-btn="${v}"]`);
				const setLogoNav = (v) => {
					// data-logo-nav en <html> es lo que el CSS usa para mostrar
					// el Isotipo o la Bandera (ver global.css). El Layout lo aplica
					// a todas las páginas al cargar; acá lo forzamos en vivo.
					document.documentElement.dataset.logoNav = v;
					try {
						localStorage.setItem(NAV_KEY, v);
					} catch (e) {
						/* ignorar */
					}
					['isotipo', 'bandera'].forEach((k) => {
						const b = btn(k);
						if (!b) return;
						const on = k === v;
						b.setAttribute('aria-pressed', String(on));
						b.classList.toggle('border-brand', on);
						b.classList.toggle('bg-brand', on);
						b.classList.toggle('text-white', on);
						b.classList.toggle('border-divider', !on);
						b.classList.toggle('bg-white', !on);
						b.classList.toggle('text-ink', !on);
					});
				};
				document.querySelectorAll('[data-logo-nav-btn]').forEach((b) => {
					b.addEventListener('click', () => setLogoNav(b.dataset.logoNavBtn));
				});
				let navInit = 'isotipo';
				try {
					if (localStorage.getItem(NAV_KEY) === 'bandera') navInit = 'bandera';
				} catch (e) {
					/* ignorar */
				}
				setLogoNav(navInit);

				const LOGO_KEY = 'lalangue-logo-h';
				const range = document.getElementById('logo-h-range');
				const number = document.getElementById('logo-h-number');
				const setLogoH = (v) => {
					document.documentElement.style.setProperty('--logo-h', String(v));
					// La vista previa del navbar de esta misma sección también lo toma
					// (heredan --logo-h de :root).
					try {
						localStorage.setItem(LOGO_KEY, String(v));
					} catch (e) {
						/* ignorar */
					}
				};
				if (range && number) {
					const sync = (v) => {
						range.value = v;
						number.value = v;
						setLogoH(v);
					};
					// Valor inicial: 11 (default) o el guardado.
					let init = 11;
					try {
						const stored = parseInt(localStorage.getItem(LOGO_KEY) || '', 10);
						if (Number.isFinite(stored) && stored >= 8 && stored <= 24) init = stored;
					} catch (e) {
						/* ignorar */
					}
					sync(init);
					range.addEventListener('input', () => sync(range.value));
					number.addEventListener('change', () => sync(number.value));
				}
			</script>
		</section>

		<!-- ================= Isotipo — colección mixta ================= -->
		<section class="mt-16">
			<h2>Isotipo — colección mixta</h2>
			<p class="text-ink/80">
				Un plano, el original en greyscale y combinaciones de la paleta:
				cada celda pinta los tres grupos del SVG con su propia terna de
				colores.
			</p>
			<div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
				{
					isotipoMarks.map((m) => (
						<div class="flex flex-col rounded-xl border border-divider/30 bg-surface p-5">
							<div
								class="flex flex-1 items-center justify-center rounded-lg bg-white p-4"
							>
								<Isotipo
									wine={m.wine}
									accent={m.accent}
									indigo={m.indigo}
									class="h-20 w-auto"
								/>
							</div>
							<div class="mt-3 text-center">
								<p class="text-xs font-medium text-ink-strong">{m.name}</p>
								<p class="mt-0.5 font-mono text-[0.6875rem] text-muted">
									{m.wine} · {m.accent} · {m.indigo}
								</p>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- ================= Estilos globales ================= -->
		<section class="mt-16">
			<h2>Estilos globales</h2>
			<p class="text-ink/80">
				Aplicados desde <code>src/styles/global.css</code>. Margen y
				padding se indican siempre.
			</p>
			<div class="mt-8 grid gap-6 md:grid-cols-2">
				{
					globalStyles.map((s) => (
						<article class="rounded-lg border border-divider/30 bg-surface p-5">
							<div class="mb-1 flex items-baseline gap-2">
								<code class="text-[0.9375rem] font-bold text-brand">{s.tag}</code>
								<span class="text-xs text-ink/60">{s.desc}</span>
							</div>
							<div class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-0.5 text-sm">
								{
									s.specs.map(([k, v]) => (
										<>
											<span
												class:list={[
													'leading-6',
													k === 'Margen' ||
													k === 'Margen inferior' ||
													k === 'Margen superior' ||
													k.startsWith('Padding')
														? 'font-medium text-brand'
														: 'text-ink/70',
												]}
											>
												{k}
											</span>
											<code class="leading-6">{v}</code>
										</>
									))
								}
							</div>
							{ s.sample && <Sample html={samples[s.sample]} /> }
						</article>
					))
				}
			</div>
		</section>

		<!-- ================= Estilos del menú ================= -->
		<section class="mt-16">
			<h2>Estilos del menú</h2>
			<p class="text-ink/80">
				Implementados en <code>src/components/Header.astro</code>.
			</p>
			<div class="mt-8 grid gap-6 md:grid-cols-2">
				{
					menuStyles.map((s) => (
						<article class="rounded-lg border border-divider/30 bg-surface p-5">
							<div class="mb-1 flex items-baseline gap-2">
								<code class="text-[0.9375rem] font-bold text-brand">{s.tag}</code>
								<span class="text-xs text-ink/60">{s.desc}</span>
							</div>
							<div class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-0.5 text-sm">
								{
									s.specs.map(([k, v]) => (
										<>
											<span
												class:list={[
													'leading-6',
													k === 'Margen' ||
													k.includes('Padding') ||
													k.includes('padding')
														? 'font-medium text-brand'
														: 'text-ink/70',
												]}
											>
												{k}
											</span>
											<code class="leading-6">{v}</code>
										</>
									))
								}
							</div>
							{ s.sample && <Sample html={samples[s.sample]} onLight /> }
						</article>
					))
				}
			</div>
		</section>
	</main>
</Layout>