---
/**
 * Home — Facultad Internacional de Psicología y Psicoanálisis Lalangue.
 *
 * El hero vive escrito acá; el resto de las secciones salen de home.ts, que
 * reutiliza las secciones compartidas de /facultad y agrega los carruseles de
 * plantel y formaciones + el cierre. El diseño se define UNA VEZ en
 * BloqueRender.astro.
 */
import Layout from '../layouts/Layout.astro';
import BloqueRender from '../components/formacion/BloqueRender.astro';
import ComponenteComun from '../components/formacion/ComponenteComun.astro';
import ModalPersona from '../components/ModalPersona.astro';
import { homeSecciones } from '../data/home';
---

<Layout title="Facultad Internacional de Psicología y Psicoanálisis Lalangue" overlay>
	<!-- El main envuelve TODO el contenido de la home (hero incluido) y es
	     quien define los gutter: lleva la clase .contenedor (1152px + padding
	     fluido), el mismo contenedor que header, footer y el resto de las
	     páginas. Las section internas NO repiten contenedor propio; solo
	     aplican su padding, separación y medidas de lectura. -->
	<main class="contenedor flex-1 pb-16">
		<!-- ==================== Hero vh100 ==================== -->
		<!-- El header es transparente y fixed (modo overlay): el hero ocupa los
		     100dvh completos y el fondo se ve por detrás de la navbar. La
		     utilidad full-bleed rompe el .contenedor del
		     main para que el fondo cubra todo el ancho; el contenido se
		     re-centra con un .contenedor interno. Fondo = placeholder. -->
		<section
			id="hero"
			class="full-bleed flex min-h-[100dvh] flex-col justify-center overflow-hidden bg-gradient-to-br from-brand-dark via-brand to-night py-16"
		>
			<div class="contenedor relative">
				<p class="text-sm font-medium uppercase tracking-widest text-accent">
					Institución académica francesa · formación clínica y psicoanálisis
				</p>
				<h1
					class="mt-4 max-w-5xl font-semibold leading-[1.05] text-white text-7xl"
				>
					Facultad Internacional de Psicología y Psicoanálisis Lalangue
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">
					Institución académica francesa dedicada a la formación clínica y al
					desarrollo del pensamiento contemporáneo en psicología y
					psicoanálisis. Construyendo una clínica rigurosa, ética,
					internacional y plural, para toda la comunidad hispanohablante
					global.
				</p>
				<div class="mt-10 flex flex-wrap gap-4">
					<a
						href="#formaciones"
						class="rounded-md bg-white px-6 py-3 font-display text-base font-semibold uppercase tracking-wide text-brand transition-colors hover:bg-accent hover:text-white hover:no-underline"
					>
						Explorar formaciones
					</a>
				</div>
			</div>
			<!-- Placeholder del fondo del hero (reemplazar por imagen real) -->
			<span
				aria-hidden="true"
				class="absolute bottom-6 right-8 text-xs font-semibold uppercase tracking-widest text-white/40"
			>
				IMG · fondo del hero (placeholder)
			</span>
		</section>

		<!-- ==================== Secciones ==================== -->
		<!-- Plantel · Formaciones · Metodología · Modelo académico · Mapa
		     (inserción laboral) · Esta institución es para ti si · Salida
		     laboral internacional · Supervisión · Cierre (Tender puentes +
		     Preguntas Frecuentes). Ver src/data/home.ts. -->
		<div class="mt-16">
			{
				homeSecciones.map((seccion) =>
					seccion.tipo === 'componente' ? (
						<ComponenteComun nombre={seccion.nombre} />
					) : (
						<BloqueRender bloque={seccion} />
					),
				)
			}
		</div>
	</main>

	<!-- Popup de perfil del carrusel de plantel (cards con modal). -->
	<ModalPersona />
</Layout>
