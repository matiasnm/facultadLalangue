 * Isotipo — src/components/Isotipo.astro (docs/logo_indigo.svg).
 * Los 3 slots permiten recolorear el logo; las opciones de cada slot se
 * cargan dinámicamente desde la paleta elegida para el isotipo (dropdown
 * "Paleta para el isotipo" en el editor en vivo). Estos datos solo
 * mantienen etiqueta y nota.
 */
const isotipoSlots = [
	{
		id: 'c1',
		label: 'Color 1 · Vino',
		original: 'original #620f31',
	},
	{
		id: 'c2',
		label: 'Color 2 · Naranja',
		original: 'original #d5653e',
	},
	{
		id: 'c3',
		label: 'Color 3 · Índigo',
		original: 'original #4c3c6c',
