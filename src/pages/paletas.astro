---
import Layout from '../layouts/Layout.astro';
import { paletas, defaultTokens } from '../data/paletas';

const base = import.meta.env.BASE_URL;
const link = (href: string) =>
	href.startsWith('/') && href.length > 1 && !href.startsWith('//') ? base + href.slice(1) : href;

// Datos para el script (se inyectan con define:vars).
const defaultsData = defaultTokens;
const paletasData = paletas;
---

<Layout title="Paletas — Lalangue">
	<main class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6">
		<a href={link('/roadmap/')} class="text-sm text-brand hover:underline"
			>← Volver al roadmap de estilos</a
		>
		<h1 class="mt-4">Paletas candidatas</h1>
		<p class="mt-2 max-w-2xl text-ink/80">
			Estas son las 5 paletas derivadas de las familias de color que
			teníamos en mano (bordeaux, teal, rosa cereza, marfil y azul). Cada
			una lleva <strong>su propia marca</strong> y repinta todo el sitio
			en el momento — incluido el isotipo del header y del footer.
			Elegí una para <em>previsualizarla en vivo</em>: se guarda en tu
			navegador y persiste entre páginas. <em>Restaurar</em> vuelve a los
			colores oficiales actuales.
		</p>

		<!-- Selector de paletas -->
		<section class="mt-10">
			<div
				id="paleta-grid"
				class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
			></div>
		</section>

		<!-- Cómo aplicar -->
		<section class="mt-10">
			<h2>Cómo usar esto</h2>
			<ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink/80">
				<li>Hacé clic en una paleta para aplicarla a todo el sitio.</li>
				<li>Navegá por el sitio: el cambio persiste entre páginas.</li>
				<li>
					El isotipo usa los colores de marca de la paleta activa
					(<code>brand</code>, <code>accent</code> e <code>indigo</code>).
				</li>
				<li>
					Usá <strong>Restaurar</strong> (en el roadmap o en la tarjeta
					activa) para volver a los colores oficiales vigentes.
				</li>
			</ul>
		</section>
	</main>

	<script
		define:vars={{
			paletasData,
			defaultsData,
		}}
	>
		// Paletas y tokens por defecto, inyectados por define:vars.
		const PALETAS = paletasData;
		const DEFAULT_TOKENS = defaultsData;
		const KEY = window.__LALANGUE_PALETA.KEY;

		const grid = document.getElementById('paleta-grid');

		// Aplica una paleta: pinta :root y persiste (sitio completo).
		const applyPalette = (paleta) => {
			const state = { ...DEFAULT_TOKENS, ...paleta.tokens };
			localStorage.setItem(KEY, JSON.stringify(state));
			for (const [k, v] of Object.entries(state)) {
				document.documentElement.style.setProperty(`--color-${k}`, v);
			}
			render();
		};

		const restoreDefault = () => {
			localStorage.removeItem(KEY);
			for (const [k, v] of Object.entries(DEFAULT_TOKENS)) {
				document.documentElement.style.setProperty(`--color-${k}`, v);
			}
			render();
		};

		const card = (paleta) => {
			const active = paleta.__active;
			const el = document.createElement('button');
			el.type = 'button';
			el.className =
				'group flex flex-col rounded-xl border p-5 text-left transition-all ' +
				(active
					? 'border-brand bg-brand/5 shadow-[0_0_0_1px_var(--color-brand)]'
					: 'border-divider bg-surface hover:border-brand/40 hover:shadow-md');

			const head = document.createElement('div');
			head.className = 'flex items-center justify-between gap-2';
			const name = document.createElement('p');
			name.className = 'text-base font-semibold text-ink-strong';
			name.textContent = paleta.nombre;
			head.appendChild(name);
			if (active) {
				const tag = document.createElement('span');
				tag.className =
					'rounded-full bg-brand px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white';
				tag.textContent = 'Activa';
				head.appendChild(tag);
			}
			el.appendChild(head);

			const desc = document.createElement('p');
			desc.className = 'mt-1 text-xs leading-relaxed text-ink/70';
			desc.textContent = paleta.desc;
			el.appendChild(desc);

			const swatches = document.createElement('div');
			swatches.className = 'mt-4 flex items-center gap-1.5';
			paleta.swatches.forEach((sw) => {
				const chip = document.createElement('span');
				chip.title = `${sw.nombre} ${sw.hex}`;
				chip.className = 'h-7 w-7 rounded-full shadow-[inset_0_0_0_1px_rgba(20,20,26,0.12)]';
				chip.style.background = sw.hex;
				swatches.appendChild(chip);
			});
			el.appendChild(swatches);

			const hexLine = document.createElement('p');
			hexLine.className = 'mt-3 truncate font-mono text-[0.6875rem] text-muted';
			hexLine.textContent = paleta.swatches.map((s) => s.hex).join(' · ');
			el.appendChild(hexLine);

			const action = document.createElement('span');
			action.className =
				'mt-4 inline-flex w-fit items-center gap-1 text-sm font-semibold ' +
				(active ? 'text-brand' : 'text-brand group-hover:text-brand');
			action.textContent = active
				? 'Activa — click para restaurar los colores oficiales'
				: 'Aplicar esta paleta';
			el.appendChild(action);

			el.addEventListener('click', () =>
				active ? restoreDefault() : applyPalette(paleta),
			);
			return el;
		};

		const render = () => {
			// Re-evalúa la paleta activa a partir del estado persistido
			// (cada paleta tiene un `brand` único).
			let saved = {};
			try {
				saved = JSON.parse(localStorage.getItem(KEY) || 'null') || {};
			} catch (e) {}
			const activeBrand = saved['brand'];
			PALETAS.forEach((p) => {
				p.__active = !!activeBrand && activeBrand === p.tokens['brand'];
			});
			grid.replaceChildren(...PALETAS.map(card));
		};

		render();
	</script>
</Layout>