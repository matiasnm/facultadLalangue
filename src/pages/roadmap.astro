	logo: '<a href="/" class="inline-flex items-center gap-[1.4063rem] hover:no-underline"><img src="/isotipo.svg" alt="Logo FIPP Lalangue" class="h-11 w-auto" /><span class="flex flex-col leading-none"><span class="flex w-full justify-between font-heading text-[0.8203rem] font-medium leading-none text-night/70"><span>F</span><span>A</span><span>C</span><span>U</span><span>L</span><span>T</span><span>A</span><span>D</span></span><span class="-ml-[0.05em] font-heading text-[1.2891rem] font-semibold leading-none text-night">Lalangue</span></span></a>',
	menu:
		'<ul class="flex items-center gap-[30px] whitespace-nowrap font-display text-[15px] font-normal uppercase tracking-wide"><li class="text-night hover:text-accent">Conócenos</li><li class="text-night hover:text-accent">Formaciones</li><li class="text-night hover:text-accent">Mediateca</li><li class="text-night hover:text-accent">Campus</li></ul>',
	menulink:
		'<a href="#" class="inline-block py-2 font-display text-[15px] font-normal uppercase tracking-wide text-night transition-colors hover:text-accent">Conócenos</a>',
	chevron:
		'<span class="inline-flex items-center gap-1 font-display text-[15px] font-normal uppercase tracking-wide text-night"><span>Formaciones</span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-[13.125px]" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>',
	submenu:
		'<a href="#" class="inline-block px-4 py-2 font-display text-base font-normal uppercase tracking-wide text-night transition-colors hover:bg-brand/5 hover:text-accent">Facultad</a>',
	burger:
		'<button type="button" class="inline-flex rounded-lg p-2 text-accent"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg></button>',
	summary:
		'<div class="max-w-xs border-b border-divider/40"><div class="flex items-center justify-between py-3 font-display text-base font-normal uppercase tracking-wide text-night"><span>Conócenos</span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5 text-accent" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></div></div>',
	msubmenu:
		'<a href="#" class="inline-block py-2 font-display text-base font-normal uppercase tracking-wide text-night/80 hover:text-accent">Facultad</a>',
	mlink:
		'<a href="#" class="inline-block py-3 font-display text-base font-normal uppercase tracking-wide text-night hover:text-accent">Mediateca</a>',
};
---

<Layout title="Roadmap de estilos — Facultad LaLagüe">
	<main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/" class="text-sm text-brand hover:underline">← Volver al sitio</a>
		<h1 class="mt-6">Roadmap de estilos</h1>
		<p class="text-ink/80">
			Especificación completa de la paleta, los estilos globales y del menú
			de <code>facultad-lalague</code>. Última actualización: {lastUpdated}.
		</p>

		<!-- ================= Editor de paleta en vivo ================= -->
		<section class="mt-12 rounded-xl border-2 border-dashed border-accent/50 bg-surface p-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<p class="text-lg font-semibold text-night">Editor de paleta en vivo</p>
					<p class="mt-1 text-sm text-ink/70">
						Cambiá un color y se repinta todo el sitio (también el isotipo del
						header). Se guarda en tu navegador (localStorage) y sobrevive a las
						recargas. Usá <em>Restaurar</em> para volver a la paleta oficial.
					</p>
				</div>
				<button
					id="palette-reset"
					type="button"
					class="rounded-md border border-divider bg-white px-4 py-2 text-sm font-semibold text-night transition-colors hover:border-brand hover:text-brand"
				>
					Restaurar colores default
				</button>
			</div>

			<div id="palette-pickers" class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-5">
				<p class="col-span-full text-xs font-semibold uppercase tracking-widest text-muted">
					Marca y acentos
				</p>
				{/* brand, accent, indigo, night */}
				{
					['brand', 'accent', 'indigo', 'night'].map((t) => (
						<div class="flex items-center gap-3 rounded-lg border border-divider bg-white p-3">
							<input
								type="color"
								data-palette-token={t}
								class="h-9 w-9 cursor-pointer rounded border border-divider bg-white p-0"
							/>
							<div class="min-w-0">
								<p class="text-xs font-semibold text-ink-strong">{t === 'brand' ? 'Vino' : t === 'accent' ? 'Naranja' : t === 'indigo' ? 'Índigo' : t === 'night' ? 'Noche' : t}</p>
								<p class="truncate font-mono text-[0.6875rem] text-muted">--color-{t}</p>
							</div>
						</div>
					))
				}

				<p class="col-span-full mt-2 text-xs font-semibold uppercase tracking-widest text-muted">
					Neutros y superficies
				</p>
				{
					['background', 'surface', 'divider', 'ink', 'muted'].map((t) => (
						<div class="flex items-center gap-3 rounded-lg border border-divider bg-white p-3">
							<input
								type="color"
								data-palette-token={t}
								class="h-9 w-9 cursor-pointer rounded border border-divider bg-white p-0"
							/>
							<div class="min-w-0">
								<p class="text-xs font-semibold text-ink-strong">{t}</p>
								<p class="truncate font-mono text-[0.6875rem] text-muted">--color-{t}</p>
							</div>
						</div>
					))
				}
			</div>

			<script>
				(() => {
					const { KEY, TOKENS } = window.__LALANGUE_PALETA;
					const inputs = Array.from(document.querySelectorAll('[data-palette-token]'));
					const resetBtn = document.getElementById('palette-reset');

					// Sincronizar cada input con el estado actual (guardado o default).
					const sync = () => {
						let saved = {};
						try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
						inputs.forEach((el) => {
							el.value = saved[el.dataset.paletteToken] || TOKENS[el.dataset.paletteToken];
						});
					};

					const apply = (token, value) => {
						document.documentElement.style.setProperty(`--color-${token}`, value);
					};

					const persist = () => {
						const state = {};
						inputs.forEach((el) => { state[el.dataset.paletteToken] = el.value; });
						localStorage.setItem(KEY, JSON.stringify(state));
					};

					inputs.forEach((el) => {
						el.addEventListener('input', () => apply(el.dataset.paletteToken, el.value));
						el.addEventListener('change', persist);
					});

					resetBtn.addEventListener('click', () => {
						localStorage.removeItem(KEY);
						inputs.forEach((el) => {
							el.value = TOKENS[el.dataset.paletteToken];
							apply(el.dataset.paletteToken, TOKENS[el.dataset.paletteToken]);
						});
					});

					sync();
				})();
			</script>
		</section>

		<!-- ================= Paleta de colores ================= -->
		<section class="mt-16">
			<h2>Paleta de colores</h2>
			<p class="text-ink/80">
				Paleta definitiva: un acento cálido y una escala de vino a azul,
				más la sub-paleta <em>vino profundo</em> y los neutros.
			</p>
			<div
				class="mt-8 overflow-x-auto rounded-xl border border-divider/30 bg-surface p-6"
			>
				<div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1fr]">
					<!-- Paleta principal -->
					<div>
						<p class="text-xs font-medium uppercase tracking-widest text-muted">
							Paleta principal
						</p>
						<div class="mt-4 flex flex-wrap gap-2.5">
							{
								paletteMain.map((c) => (
									<div
										class="relative flex h-[132px] w-[112px] flex-col items-center justify-end rounded-[10px] p-2 text-center text-xs text-white"
										style={`background:${c.hex}`}
									>
										{ c.highlight && (
											<span class="absolute left-1/2 top-2 -translate-x-1/2 rounded-full bg-[#ffd27a] px-2 py-0.5 text-[9px] font-semibold text-[#3a2c00]">
												HIGHLIGHT
											</span>
										) }
										<span class="font-mono">{c.hex}</span>
										<span class="mt-0.5 text-[10px] opacity-80">{c.name}</span>
									</div>
								))
							}
						</div>
					</div>

					<!-- Sub-paleta y neutros -->
					<div class="space-y-6">
						<div class="rounded-xl border border-dashed border-divider/60 bg-white p-4">
							<p class="text-xs font-medium uppercase tracking-widest text-muted">
								Sub-paleta — Vino profundo
							</p>
							<p class="mt-1 text-xs leading-relaxed text-ink/70">
								Encajan entre el vino y el malbec (matiz ~332–335°).
								«Tal cual» si querés nota oscura; A/B como puente
								para gradiente continuo.
							</p>
							<div class="mt-3 flex flex-wrap gap-2.5">
								{
									paletteWine.map((c) => (
										<div
											class="flex h-[116px] w-[104px] flex-col items-center justify-end rounded-[10px] p-2 text-center text-[11px] text-white"
											style={`background:${c.hex}`}
										>
											<span class="font-mono">{c.hex}</span>
											<span class="mt-0.5 text-[10px] opacity-80">{c.name}</span>
										</div>
									))
								}
							</div>
						</div>

						<div class="rounded-xl border border-dashed border-divider/60 bg-white p-4">
							<p class="text-xs font-medium uppercase tracking-widest text-muted">
								Escala neutra
							</p>
							<p class="mt-1 text-xs leading-relaxed text-ink/70">
								Fondo, superficies, bordes y jerarquías de texto.
							</p>
							<div class="mt-3 flex flex-wrap gap-2.5">
								{
									paletteNeutrals.map((c) => (
										<div
											class:list={[
												'flex h-[116px] w-[104px] flex-col items-center justify-end rounded-[10px] p-2 text-center text-[11px]',
												c.darkText ? 'text-[#14141a]' : 'text-white',
												'shadow-[inset_0_0_0_1px_rgba(20,20,26,0.08)]',
											]}
											style={`background:${c.hex}`}
										>
											<span class="font-mono">{c.hex}</span>
											<span class="mt-0.5 text-[10px] opacity-80">{c.name}</span>
										</div>
									))
								}
							</div>
						</div>
					</div>
				</div>

				<p class="mt-6 border-t border-divider/60 pt-4 text-xs leading-relaxed text-muted">
					Orden final:{' '}
					<code class="text-brand">{paletteOrder}</code>
				</p>
			</div>
		</section>

		<!-- ================= Isotipo ================= -->
		<section class="mt-16">
			<h2>Isotipo</h2>
			<p class="text-ink/80">
				<code>docs/logo_indigo.svg</code> — el isotipo (solo el símbolo,
				sin texto) tiene 3 colores (vino, naranja e índigo). Elegí para
				cada uno de ellos uno de los colores ya conocidos de la paleta o
				de la escala de grises y el recolor se aplica en vivo:
			</p>

			<div
				class="mt-8 grid gap-8 overflow-hidden rounded-xl border border-divider/30 bg-surface p-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]"
			>
				<!-- Preview del isotipo sobre blanco -->
				<div
					id="isotipo-live"
					class="flex items-center justify-center rounded-xl bg-white p-10"
				>
					<Isotipo
						class="h-40 w-auto"
						wine="var(--color-brand)"
						accent="var(--color-accent)"
						indigo="var(--color-indigo)"
					/>
				</div>

				<!-- Pickers de color -->
				<div class="flex flex-col justify-center gap-5">
					{
						isotipoSlots.map((slot) => (
							<div>
								<div class="flex items-baseline gap-2">
									<span class="text-sm font-medium text-ink-strong">{slot.label}</span>
									<span class="text-xs text-muted">{slot.original}</span>
								</div>
								<div class="mt-2">
									<label class="sr-only" for={`iso-${slot.id}`}>
										{slot.label}
									</label>
									<select
										id={`iso-${slot.id}`}
										data-iso-slot={slot.id}
										class="w-full rounded-md border border-divider bg-white px-3 py-2 text-sm text-ink"
									>
										{
											isotipoOptions.map((opt) => (
												<option value={opt.hex} selected={opt.hex === slot.default}>
													{opt.hex} — {opt.name}
												</option>
											))
										}
									</select>
								</div>
							</div>
						))
					}
					<p class="text-xs leading-relaxed text-muted">
						El isotipo se repinta en el momento: los tres grupos del
						SVG se pintan con las variables CSS seleccionadas
						(<code class="text-brand">--iso-c1/c2/c3</code>).
					</p>
				</div>
			</div>
			<script>
				const iso = document.querySelector('#isotipo-live .isotipo');
				if (iso) {
					document.querySelectorAll('[data-iso-slot]').forEach((sel) => {
						sel.addEventListener('change', () => {
							iso.style.setProperty(`--iso-${sel.dataset.isoSlot}`, sel.value);
						});
					});
				}
			</script>
		</section>

		<!-- ================= Isotipo — colección mixta ================= -->
		<section class="mt-16">
			<h2>Isotipo — colección mixta</h2>
			<p class="text-ink/80">
				Un plano, el original en greyscale y combinaciones de la paleta:
				cada celda pinta los tres grupos del SVG con su propia terna de
				colores.
			</p>
			<div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
				{
					isotipoMarks.map((m) => (
						<div class="flex flex-col rounded-xl border border-divider/30 bg-surface p-5">
							<div
								class="flex flex-1 items-center justify-center rounded-lg bg-white p-4"
							>
								<Isotipo
									wine={m.wine}
									accent={m.accent}
									indigo={m.indigo}
									class="h-20 w-auto"
								/>
							</div>
							<div class="mt-3 text-center">
								<p class="text-xs font-medium text-ink-strong">{m.name}</p>
								<p class="mt-0.5 font-mono text-[0.6875rem] text-muted">
									{m.wine} · {m.accent} · {m.indigo}
								</p>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- ================= Estilos globales ================= -->
		<section class="mt-16">
			<h2>Estilos globales</h2>
			<p class="text-ink/80">
				Aplicados desde <code>src/styles/global.css</code>. Margen y
				padding se indican siempre.
			</p>
			<div class="mt-8 grid gap-6 md:grid-cols-2">
				{
					globalStyles.map((s) => (
						<article class="rounded-lg border border-divider/30 bg-surface p-5">
							<div class="mb-1 flex items-baseline gap-2">
								<code class="text-[0.9375rem] font-bold text-brand">{s.tag}</code>
								<span class="text-xs text-ink/60">{s.desc}</span>
							</div>
							<div class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-0.5 text-sm">
								{
									s.specs.map(([k, v]) => (
										<>
											<span
												class:list={[
													'leading-6',
													k === 'Margen' ||
													k === 'Margen inferior' ||
													k === 'Margen superior' ||
													k.startsWith('Padding')
														? 'font-medium text-brand'
														: 'text-ink/70',
												]}
											>
												{k}
											</span>
											<code class="leading-6">{v}</code>
										</>
									))
								}
							</div>
							{ s.sample && <Sample html={samples[s.sample]} /> }
						</article>
					))
				}
			</div>
		</section>

		<!-- ================= Estilos del menú ================= -->
		<section class="mt-16">
			<h2>Estilos del menú</h2>
			<p class="text-ink/80">
				Implementados en <code>src/components/Header.astro</code>.
			</p>
			<div class="mt-8 grid gap-6 md:grid-cols-2">
				{
					menuStyles.map((s) => (
						<article class="rounded-lg border border-divider/30 bg-surface p-5">
							<div class="mb-1 flex items-baseline gap-2">
								<code class="text-[0.9375rem] font-bold text-brand">{s.tag}</code>
								<span class="text-xs text-ink/60">{s.desc}</span>
							</div>
							<div class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-0.5 text-sm">
								{
									s.specs.map(([k, v]) => (
										<>
											<span
												class:list={[
													'leading-6',
													k === 'Margen' ||
													k.includes('Padding') ||
													k.includes('padding')
														? 'font-medium text-brand'
														: 'text-ink/70',
												]}
											>
												{k}
											</span>
											<code class="leading-6">{v}</code>
										</>
									))
								}
							</div>
							{ s.sample && <Sample html={samples[s.sample]} onLight /> }
						</article>
					))
				}
			</div>
		</section>
	</main>
</Layout>