---
/**
 * Página de formación (ruta dinámica de raíz).
 * Se genera una página por cada entrada de src/data/formaciones.ts, en la
 * URL definida por su `slug` (que coincide con la ruta citada en el menú).
 *
 * La página NO define contenido: declara los datos de la formación (encabezado
 * y meta) y renderiza sus `secciones` — bloques directos y componentes comunes
 * — exclusivamente a través de los componentes de render de
 * src/components/formacion/. Cualquier cambio de diseño se hace una sola vez
 * en BloqueRender y se propaga a todas las páginas.
 */
import Layout from '../layouts/Layout.astro';
import { formaciones } from '../data/formaciones';
import BloqueRender from '../components/formacion/BloqueRender.astro';
import ComponenteComun from '../components/formacion/ComponenteComun.astro';

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
	return formaciones.map((f) => ({
		params: { slug: f.slug },
		props: { formacion: f },
	}));
}

interface Props {
	formacion: (typeof formaciones)[number];
}
const { formacion } = Astro.props;
---

<Layout title={`${formacion.titulo} — Facultad Lalangue`}>
	<main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
		<!-- Volver al inicio -->
		<a
			href={base || '/'}
			class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-accent hover:no-underline"
		>
			<span aria-hidden="true">←</span> Volver al inicio
		</a>

		<!-- Encabezado -->
		<header class="mt-6">
			{formacion.kicker && <p class="text-sm font-semibold text-accent">{formacion.kicker}</p>}
			<p class="mt-2 text-xs font-semibold uppercase tracking-widest text-accent">
				{formacion.categoria}
			</p>
			<h1 class="mt-2 max-w-4xl text-4xl font-semibold leading-tight sm:text-5xl">
				{formacion.titulo}
			</h1>
			<p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink/80">{formacion.descripcion}</p>
		</header>

		<!-- Meta -->
		<div class="mt-10 grid gap-4 sm:grid-cols-3">
			<div class="rounded-lg border border-divider/30 bg-surface p-5">
				<p class="text-xs font-semibold uppercase tracking-widest text-muted">Duración</p>
				<p class="mt-2 text-sm font-medium text-night">{formacion.duracion}</p>
			</div>
			<div class="rounded-lg border border-divider/30 bg-surface p-5">
				<p class="text-xs font-semibold uppercase tracking-widest text-muted">Modalidad</p>
				<p class="mt-2 text-sm font-medium text-night">{formacion.modalidad}</p>
			</div>
			<div class="rounded-lg border border-divider/30 bg-surface p-5">
				<p class="text-xs font-semibold uppercase tracking-widest text-muted">Dirigido a</p>
				<p class="mt-2 text-sm font-medium text-night">{formacion.dirigidoA}</p>
			</div>
		</div>

		<!-- Contenido: bloques + componentes comunes -->
		<div class="mt-12">
			{formacion.secciones.map((seccion) =>
				seccion.tipo === 'componente' ? (
					<ComponenteComun nombre={seccion.nombre} />
				) : (
					<BloqueRender bloque={seccion} />
				),
			)}
		</div>
	</main>
</Layout>