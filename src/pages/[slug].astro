---
/**
 * Página de formación (ruta dinámica de raíz).
 * Se genera una página por cada entrada de src/data/formaciones.ts, en la
 * URL definida por su `slug` (que coincide con la ruta citada en el menú).
 * Esquema mínimo con placeholders.
 */
import Layout from '../layouts/Layout.astro';
import { formaciones } from '../data/formaciones';

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
	return formaciones.map((f) => ({
		params: { slug: f.slug },
		props: { formacion: f },
	}));
}

interface Props {
	formacion: (typeof formaciones)[number];
}
const { formacion } = Astro.props;
---

<Layout title={`${formacion.titulo} — Facultad Lalangue`}>
	<main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
		<!-- Volver al inicio -->
		<a
			href={base || '/'}
			class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-accent hover:no-underline"
		>
			<span aria-hidden="true">←</span> Volver al inicio
		</a>

		<!-- Encabezado -->
		<header class="mt-6">
			<p class="text-xs font-semibold uppercase tracking-widest text-accent">
				{formacion.categoria}
			</p>
			<h1 class="mt-2 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl">
				{formacion.titulo}
			</h1>
			<p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink/80">
				{formacion.descripcion}
			</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<a
					href="#"
					class="rounded-md bg-accent px-6 py-3 font-display text-base font-semibold uppercase tracking-wide text-night transition-colors hover:bg-brand hover:text-white hover:no-underline"
				>
					Solicitá información
				</a>
				<a
					href="#"
					class="rounded-md border border-divider px-6 py-3 font-display text-base font-semibold uppercase tracking-wide text-night transition-colors hover:border-brand hover:text-brand hover:no-underline"
				>
					Ver programa
				</a>
			</div>
		</header>

		<!-- Meta -->
		<div class="mt-10 grid gap-4 sm:grid-cols-3">
			<div class="rounded-lg border border-divider/30 bg-surface p-5">
				<p class="text-xs font-semibold uppercase tracking-widest text-muted">
					Duración
				</p>
				<p class="mt-2 text-sm font-medium text-night">{formacion.duracion}</p>
			</div>
			<div class="rounded-lg border border-divider/30 bg-surface p-5">
				<p class="text-xs font-semibold uppercase tracking-widest text-muted">
					Modalidad
				</p>
				<p class="mt-2 text-sm font-medium text-night">{formacion.modalidad}</p>
			</div>
			<div class="rounded-lg border border-divider/30 bg-surface p-5">
				<p class="text-xs font-semibold uppercase tracking-widest text-muted">
					Dirigido a
				</p>
				<p class="mt-2 text-sm font-medium text-night">{formacion.dirigidoA}</p>
			</div>
		</div>

		<!-- Taglines (placeholder) -->
		<div class="mt-8 space-y-2 rounded-lg border border-dashed border-accent/40 bg-accent/5 p-5">
			{formacion.taglines.map((t) => (
				<p class="text-sm text-ink/75 leading-relaxed">{t}</p>
			))}
		</div>

		<!-- Segmentos de contenido -->
		<div class="mt-12 space-y-8">
			{formacion.segments.map((s) => (
				<section>
					<h2 class="text-2xl font-semibold">{s.titulo}</h2>
					<p class="mt-3 text-ink/80 leading-relaxed">{s.cuerpo}</p>
				</section>
			))}
		</div>

		<!-- Incluye -->
		<section class="mt-12">
			<h2 class="text-2xl font-semibold">¿Qué incluye?</h2>
			<ul class="mt-4 space-y-2">
				{formacion.incluye.map((i) => (
					<li class="flex items-start gap-2 text-ink/80">
						<span class="mt-1.5 size-2 shrink-0 rounded-full bg-accent"></span>
						{i}
					</li>
				))}
			</ul>
		</section>

		<!-- CTA -->
		<div class="mt-14 rounded-xl border border-divider/30 bg-surface p-8 text-center">
			<h2 class="text-2xl font-semibold">Solicitá más información</h2>
			<p class="mx-auto mt-3 max-w-xl text-ink/75 leading-relaxed">
				Una asesora te va a acompañar en el proceso de inscripción. Completá
				el formulario y te contactamos a la brevedad (placeholder).
			</p>
			<a
				href="#"
				class="mt-6 inline-block rounded-md bg-accent px-6 py-3 font-display text-base font-semibold uppercase tracking-wide text-night transition-colors hover:bg-brand hover:text-white hover:no-underline"
			>
				Solicitar información
			</a>
		</div>
	</main>
</Layout>
