---
/**
 * Contador animado 0 → valor real — misma mecánica que el original
 * (widget Counter de Elementor en /landing-master-en-psicoanalisis):
 *
 *  - Markup con los mismos data-* del original (data-duration,
 *    data-to-value, data-from-value y data-delimiter) sobre [data-contador].
 *  - IntersectionObserver con threshold 0: la animación arranca apenas el
 *    contador asoma en el viewport y corre una sola vez (unobserve).
 *  - Easing "swing" de jQuery (`0.5 - Math.cos(p·π)/2`) y separador de
 *    miles, igual que el plugin jquery-numerator que usa Elementor.
 *
 * Mejoras de accesibilidad (propias, no de Elementor):
 *  - El <span> animado es aria-hidden; el valor final vive en un sr-only.
 *  - Con <noscript> se oculta el span animado y se muestra el valor real
 *    tal cual viene en los datos.
 *  - Sin IntersectionObserver (navegador muy viejo) se muestra el final.
 *
 * Nota: el original NO respeta prefers-reduced-motion; lo imitamos — la
 * animación corre siempre al verse (solo la salta el noscript o la falta
 * de IntersectionObserver).
 */
interface Props {
	valor: string;
	/** Separador de miles: "," (original) o "." (total de beneficios). */
	delimiter?: string;
}

const { valor, delimiter = ',' } = Astro.props;

const m = /^(\D*)([\d.,]+)(\D*)$/.exec(valor) ?? [];
const prefijo = (m[1] ?? '').trim();
const numero = m[2] ? parseInt(m[2].replace(/[.,\s]/g, ''), 10) : 0;
const sufijo = (m[3] ?? '').trim();
const final = `${prefijo}${numero}${sufijo}`;
---

<span
	data-contador
	data-contador-prefijo={prefijo}
	data-contador-sufijo={sufijo}
	data-duration="2000"
	data-from-value="0"
	data-to-value={numero}
	data-delimiter={delimiter}
	aria-hidden="true"
>0</span>
<span class="sr-only">{final}</span>
<noscript>
	<style>
		[data-contador] {
			display: none;
		}
	</style>
	<span>{final}</span>
</noscript>

<script>
	const contadores = Array.from(document.querySelectorAll<HTMLElement>('[data-contador]'));

	const texto = (el: HTMLElement, n: number) => {
		const pre = el.dataset.contadorPrefijo ?? '';
		const suf = el.dataset.contadorSufijo ?? '';
		let num = String(n);
		// Separador de miles como jquery-numerator (regex estándar).
		const delim = el.dataset.delimiter;
		if (delim) num = num.replace(/\B(?=(\d{3})+(?!\d))/g, delim);
		el.textContent = pre + num + suf;
	};

	const animar = (el: HTMLElement) => {
		const desde = parseInt(el.dataset.fromValue || '0', 10);
		const hasta = parseInt(el.dataset.toValue ?? '0', 10);
		const dur = parseInt(el.dataset.duration || '2000', 10);
		// Easing "swing" de jQuery — el que usa jquery-numerator / Elementor.
		const swing = (p: number) => 0.5 - Math.cos(p * Math.PI) / 2;
		const inicio = performance.now();
		const paso = (ahora: number) => {
			const p = Math.min((ahora - inicio) / dur, 1);
			texto(el, Math.round(desde + (hasta - desde) * swing(p)));
			if (p < 1) requestAnimationFrame(paso);
		};
		texto(el, desde);
		requestAnimationFrame(paso);
	};

	if (!('IntersectionObserver' in window)) {
		// Sin IO: valor final directo, sin animación.
		contadores.forEach((el) => texto(el, parseInt(el.dataset.toValue ?? '0', 10)));
	} else {
		// Igual que el original: threshold 0 (cualquier píxel visible),
		// sin rootMargin, y una sola vez.
		const io = new IntersectionObserver(
			(entradas) => {
				for (const e of entradas) {
					if (e.isIntersecting) {
						animar(e.target as HTMLElement);
						io.unobserve(e.target);
					}
				}
			},
			{ threshold: 0 },
		);
		contadores.forEach((el) => io.observe(el));
	}
</script>