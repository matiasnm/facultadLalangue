---
/**
 * Header — navbar minimalista con proporciones estándar de la industria.
 *
 * Estilo conservado del sitio original (colores de marca, menú en Roboto
 * Condensed uppercase, hover en el accent de la paleta), pero con HTML limpio
 * y mínimo:
 *  - Alto: 3.5rem (56px) móvil / 4rem (64px) desktop.
 *  - Container: max 72rem (1152px), centrado, padding lateral 1rem → 2rem.
 *  - Logo: Isotipo (SVG) + texto HTML — "FACULTAD" (Montserrat, encaja el
 *    ancho de "Lalangue") / "Lalangue" (Montserrat).
 *  - Escala: todo el header escalado a factor 0.9375 (menú 16px → 15px)
 *    para la proporción buscada en el navbar.
 *  - Links del menú centrados verticalmente, gap de 30px entre ítems.
 *  - Dropdown: tarjeta blanca con sombra y borde redondeado.
 *  - Mobile/tablet: hamburguesa + panel deslizante con acordeón <details>
 *    (sin JavaScript salvo el toggle).
 */

import Isotipo from './Isotipo.astro';
import IsotipoBandera from './IsotipoBandera.astro';
import IconoChevron from './IconoChevron.astro';
import LogoTexto from './LogoTexto.astro';
import { base, link } from '../lib/link';

type NavChild = { label: string; href: string };
type NavItem = {
  label: string;
  href: string;
  external?: boolean;
  right?: boolean;
  children?: NavChild[];
};

// Modo overlay (solo home): el header es transparente con texto blanco sobre
// el hero y pasa a fondo blanco/texto oscuro al scrollear (JS togglea la
// clase .is-scrolled y el CSS de global.css repinta .nav-fg/.nav-fg-dim).
const { overlay = false } = Astro.props as { overlay?: boolean };
const fg = overlay ? 'nav-fg' : 'text-night';
const fgDim = overlay ? 'nav-fg-dim' : 'text-night/70';
const divider = overlay ? 'nav-divider' : 'bg-divider';

const navItems: NavItem[] = [
  {
    label: 'Formaciones',
    href: '#',
    children: [
      { label: 'Mtr. Psicoanálisis', href: '/master-en-psicoanalisis/' },
      { label: 'Dip. Psicoterapia', href: '/psicoterapia-psicoanalitica/' },
      { label: 'Dip. Subjetividad Digital', href: '/subjetividad-digital/' },
      { label: 'Dip. Clínica Parejas', href: '/clinica-de-parejas/' },
      { label: 'Dip. Psicopatología Infanto-Juvenil', href: '/psicopatologia-infanto-juvenil/' },
      { label: 'Dip. Metapsicología', href: '/metapsicologia/' },
    ],
  },
  { label: 'Mediateca', href: '/nuestra-biblioteca/' },
  { label: 'Agenda', href: '/en-construccion/' },
  {
    label: 'Campus',
    href: 'https://campus.facultadlalangue.com/cursos/',
    external: true,
    right: true,
  },
];

---

<header
	class={overlay
		? 'header-overlay'
		: 'sticky top-0 z-50 border-b border-divider/40 bg-white'}
>
	<div
		class="contenedor relative flex h-[var(--header-h)] items-center"
	>
		<!-- Logo (flex-start): el clásico o la bandera, según la elección del
		     roadmap (lalangue-logo-nav → data-logo-nav en <html>; el CSS de
		     global.css muestra uno u otro). Ambos se repintan en vivo con
		     var(--color-brand/accent/indigo). -->
		<a
			href={base || '/'}
			class="flex shrink-0 items-center gap-4 hover:no-underline"
			aria-label="Inicio — Facultad Lalangue"
		>
			<Isotipo class="logo-nav-plain h-[calc(var(--spacing)*var(--logo-h,11))] w-auto" />
			<IsotipoBandera class="logo-nav-bandera h-[calc(var(--spacing)*var(--logo-h,11))] w-auto" />
			<LogoTexto scale="header" fgDim={fgDim} fg={fg} />
		</a>

		<!-- Divider vertical de 1px separando el logo del menú -->
		<div class={`ml-[1.4063rem] h-[30px] w-px shrink-0 ${divider}`}></div>

		<!-- Navegación desktop: alineada a la izquierda (tras el divider), con
		     el último ítem (Campus) empujado a la derecha del contenedor -->
		<nav class="ml-[1.4063rem] hidden flex-1 items-center lg:flex" aria-label="Principal">
			<ul class="flex w-full items-center gap-[30px] whitespace-nowrap">
				{
					navItems.map((item) =>
						item.children ? (
							<li class="relative group">
								<a
									href={link(item.href)}
									class={`flex items-center gap-1 py-2 font-display text-[15px] font-normal uppercase tracking-wide transition-colors group-hover:text-accent hover:no-underline ${fg}`}
								>
									{item.label}
									<span><IconoChevron stroke={2.5} class="size-[13.125px]" /></span>
								</a>
								<ul
									class="invisible absolute left-0 top-full z-10 min-w-48 rounded-lg border border-divider/30 bg-white py-2 opacity-0 shadow-lg transition-all duration-150 group-hover:visible group-hover:opacity-100 focus-within:visible focus-within:opacity-100"
								>
									{
										item.children.map((child) => (
											<li>
											<a
												href={link(child.href)}
												class="block px-4 py-2 font-display text-[15px] font-normal uppercase tracking-wide text-night transition-colors hover:bg-brand/5 hover:text-accent hover:no-underline"
											>
													{child.label}
												</a>
											</li>
										))
									}
								</ul>
							</li>
						) : (
							<li class={item.right ? 'ml-auto' : ''}>
								<a
									href={link(item.href)}
									{...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									class={`block py-2 font-display text-[15px] font-normal uppercase tracking-wide transition-colors hover:text-accent hover:no-underline ${fg}`}
								>
									{item.label}
								</a>
							</li>
						),
					)
				}
			</ul>
		</nav>

		<!-- Toggle menú móvil / tablet -->
		<button
			id="menu-toggle"
			type="button"
			class="-mr-2 ml-auto rounded-lg p-2 text-accent transition-colors hover:bg-black/5 lg:hidden"
			aria-label="Abrir menú"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<svg
				aria-hidden="true"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				class="size-6"
			>
				<line x1="4" y1="7" x2="20" y2="7"></line>
				<line x1="4" y1="12" x2="20" y2="12"></line>
				<line x1="4" y1="17" x2="20" y2="17"></line>
			</svg>
		</button>
	</div>

	<!-- Panel menú móvil / tablet -->
	<nav
		id="mobile-menu"
		class="hidden max-h-[calc(100dvh_-_var(--header-h))] overflow-y-auto border-t border-divider/40 bg-white lg:hidden"
		aria-label="Principal (móvil)"
	>
		<ul class="divide-y divide-divider/20 px-4 sm:px-6">
			{
				navItems.map((item) =>
					item.children ? (
						<li>
							<details class="group">
								<summary
									class="flex cursor-pointer list-none items-center justify-between py-3 font-display text-[15px] font-normal uppercase tracking-wide text-night transition-colors [&::-webkit-details-marker]:hidden"
								>
									{item.label}
									<span class="text-accent transition-transform group-open:rotate-180">
										<IconoChevron stroke={2.5} class="size-[13.125px]" />
									</span>
								</summary>
								<ul class="pb-2 pl-4">
									{
										item.children.map((child) => (
											<li>
												<a
													href={link(child.href)}
													class="block py-2 font-display text-[15px] font-normal uppercase tracking-wide text-night/80 transition-colors hover:text-accent hover:no-underline"
												>
													{child.label}
												</a>
											</li>
										))
									}
								</ul>
							</details>
						</li>
					) : (
						<li>
							<a
								href={link(item.href)}
								{...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
								class="block py-3 font-display text-[15px] font-normal uppercase tracking-wide text-night transition-colors hover:text-accent hover:no-underline"
							>
								{item.label}
							</a>
						</li>
					),
				)
			}
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const panel = document.getElementById('mobile-menu');

	toggle.addEventListener('click', () => {
		const isOpen = panel.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!isOpen));
		toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
	});

	// Modo overlay (home): transparente sobre el hero, fondo blanco al scrollear.
	const overlayHeader = document.querySelector<HTMLElement>('header.header-overlay');
	if (overlayHeader) {
		const updateOverlay = () => {
			overlayHeader.classList.toggle('is-scrolled', window.scrollY > 8);
		};
		updateOverlay();
		window.addEventListener('scroll', updateOverlay, { passive: true });
	}
</script>