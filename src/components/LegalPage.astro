---
/**
 * LegalPage — contenedor para páginas legales (aviso legal, privacidad,
 * términos). Encabezado + breadcrumb "volver al inicio" + contenido como
 * slot. El contenido se renderiza con la tipografía del propio contenedor
 * (div con text-[0.9375rem] leading-relaxed), sin clases adicionales.
 */
import VolverInicio from './VolverInicio.astro';

interface Props {
	title: string;
	/** Etiqueta corta del tipo de documento (p. ej. "Legal"). */
	eyebrow?: string;
	/** Fecha de última actualización a mostrar en el encabezado. */
	updated?: string;
}
const { title, eyebrow = 'Legal', updated } = Astro.props;
---

<main class="contenedor-lectura flex-1 py-12">
	<VolverInicio />

	<header class="mt-6 border-b border-divider/40 pb-6">
		<p class="text-xs font-semibold uppercase tracking-widest text-accent">{eyebrow}</p>
		<h1 class="mt-2 text-3xl font-semibold leading-tight sm:text-4xl">{title}</h1>
		{updated && (
			<p class="mt-3 text-sm text-muted">Última actualización: {updated}</p>
		)}
	</header>

	<div class="mt-10 space-y-10 text-[0.9375rem] leading-relaxed text-ink/90">
		<slot />
	</div>
</main>
