---
import { link } from '../lib/link';

const redes = [
    { key: 'facebook', label: 'Facebook' },
    { key: 'twitter', label: 'X / Twitter' },
    { key: 'instagram', label: 'Instagram' },
    { key: 'linkedin', label: 'LinkedIn' },
    { key: 'youtube', label: 'YouTube' },
    { key: 'tiktok', label: 'TikTok' },
];
---

<dialog data-persona-root aria-labelledby="persona-modal-titulo" class="persona-dialog">
    <button type="button" data-persona-close aria-label="Cerrar perfil" class="persona-close">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
    <div class="persona-content">
        <div class="persona-header">
            <nav data-persona-sociales aria-label="Redes sociales del docente" class="persona-socials" hidden>
                {redes.map(({ key, label }) => (
                    <a data-persona-red={key} hidden target="_blank" rel="noopener noreferrer" aria-label={label} title={label}>
                        {key === 'twitter' ? (
                            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l7.8-8.9L.8 2h6.5l4.5 6.8L18.9 2Zm-1.1 18h1.7L6.4 3.9H4.6L17.8 20Z" /></svg>
                        ) : <img src={link(`/images/social/${key}.svg`)} width="28" height="28" alt="" aria-hidden="true" />}
                    </a>
                ))}
            </nav>
            <div class="persona-identity">
                <div data-persona-avatar class="persona-avatar"></div>
                <h2 data-persona-nombre id="persona-modal-titulo" class="persona-name"></h2>
                <p data-persona-titulo class="persona-role"></p>
            </div>
        </div>
        <div class="persona-biography">
            <div data-persona-bio></div>
            <p data-persona-sinbio hidden>Todavía no tenemos publicada su bio. ¡La sumamos pronto!</p>
        </div>
    </div>
</dialog>

<style>
    .persona-dialog { width: 1040px; max-width: calc(100% - 48px); max-height: 94dvh; margin: auto; padding: 0; overflow-y: auto; overscroll-behavior: contain; border: 1px solid #d6dadc; border-radius: 24px; background: #e8e8e8; color: #262326; box-shadow: 0 28px 90px #0006; }
    .persona-dialog::backdrop { background: #0b0b0bd1; }
    .persona-close { position: sticky; top: 16px; float: right; margin: 16px 16px -60px 0; z-index: 2; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #e8e8e8e6; color: #363638; cursor: pointer; }
    .persona-close:hover { background: #d8d8d8; }
    .persona-content { padding: 64px clamp(24px, 6vw, 80px) 56px; }
    .persona-header { display: grid; grid-template-columns: 64px minmax(0, 1fr) 64px; align-items: center; gap: 24px; padding-bottom: 40px; }
    .persona-identity { grid-column: 2; text-align: center; }
    .persona-avatar { display: grid; place-items: center; width: clamp(144px, 20vw, 200px); aspect-ratio: 1; margin: 0 auto 24px; overflow: hidden; border-radius: 50%; background: #5b11331a; color: #5b1133; font-size: 48px; font-weight: 600; }
    .persona-avatar :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
    .persona-name { margin: 0; font-family: var(--font-display, Georgia, serif); font-size: clamp(28px, 4vw, 44px); line-height: 1.15; font-weight: 500; }
    .persona-role { margin: 12px 0 0; font-size: 14px; line-height: 1.6; color: #62565c; }
    .persona-socials { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; align-items: center; gap: 12px; }
    .persona-socials[hidden], .persona-socials a[hidden] { display: none; }
    .persona-socials a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #171717; transition: transform .2s; }
    .persona-socials a:hover { transform: translateY(-2px); }
    .persona-socials img { display: block; width: 28px; height: 28px; }
    .persona-biography { width: 100%; border-top: 1px solid #26232626; padding-top: 32px; font-size: 16px; line-height: 1.85; }
    .persona-biography :global(p) { margin: 0 0 20px; }
    .persona-biography :global(ul), .persona-biography :global(ol) { margin: 0 0 20px; padding-left: 1.5em; }
    .persona-biography :global(ul) { list-style: disc; }
    .persona-biography :global(ol) { list-style: decimal; }
    .persona-biography :global(li) { margin-block: 6px; }
    .persona-biography :global(h1), .persona-biography :global(h2), .persona-biography :global(h3), .persona-biography :global(h4), .persona-biography :global(h5), .persona-biography :global(h6) { margin: 28px 0 12px; line-height: 1.3; font-weight: 600; }
    .persona-biography :global(a) { color: #8c1c3f; text-decoration: underline; }
    .persona-biography :global(blockquote) { margin: 20px 0; padding-left: 20px; border-left: 3px solid #8c1c3f; }
    .persona-biography :global(img) { max-width: 100%; height: auto; }
    .persona-biography :global(:last-child) { margin-bottom: 0; }
    .persona-dialog :is(a, button):focus-visible { outline: 2px solid #8c1c3f; outline-offset: 4px; }
    @media (max-width: 700px) {
        .persona-dialog { width: 100%; max-width: 100%; height: 100dvh; max-height: 100dvh; border: 0; border-radius: 0; }
        .persona-content { padding: 76px 20px 32px; }
        .persona-header { grid-template-columns: 44px minmax(0, 1fr); gap: 12px; padding-bottom: 28px; }
        .persona-name { font-size: 28px; overflow-wrap: anywhere; }
        .persona-role { font-size: 13px; }
        .persona-socials { gap: 8px; }
        .persona-biography { padding-top: 24px; font-size: 15px; }
    }
    @media (prefers-reduced-motion: reduce) { .persona-socials a { transition: none; } }
</style>

<script>
    const root = document.querySelector<HTMLDialogElement>('[data-persona-root]')!;
    const titulo = root.querySelector<HTMLElement>('[data-persona-titulo]')!;
    const nombre = root.querySelector<HTMLElement>('[data-persona-nombre]')!;
    const avatar = root.querySelector<HTMLElement>('[data-persona-avatar]')!;
    const bio = root.querySelector<HTMLElement>('[data-persona-bio]')!;
    const sinBio = root.querySelector<HTMLElement>('[data-persona-sinbio]')!;
    const sociales = root.querySelector<HTMLElement>('[data-persona-sociales]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-persona-close]')!;
    let ultimaCard: HTMLElement | null = null;
    let previousOverflow = '';

    const abrir = (card: HTMLElement) => {
        avatar.replaceChildren();
        if (card.dataset.personaFoto) {
            const img = document.createElement('img');
            img.src = card.dataset.personaFoto;
            img.alt = '';
            avatar.append(img);
        } else avatar.textContent = card.dataset.personaSiglas || '—';
        nombre.textContent = card.dataset.personaNombre || '';
        titulo.textContent = card.dataset.personaTitulo || '';
        titulo.hidden = !titulo.textContent;
        let paragraphs: unknown = [];
        let links: Record<string, string> = {};
        try { paragraphs = JSON.parse(card.dataset.personaBio || '[]'); } catch { /* Empty bio fallback. */ }
        try { links = JSON.parse(card.dataset.personaSociales || '{}') || {}; } catch { /* No social links. */ }
        const parrafos = (Array.isArray(paragraphs) ? paragraphs : [paragraphs]).filter((p): p is string => typeof p === 'string' && Boolean(p.trim()));
        // Plantel biographies are compiled by Astro from the Markdown body.
        const template = card.parentElement?.querySelector<HTMLTemplateElement>('[data-persona-bio-template]');
        if (template) {
            bio.replaceChildren(template.content.cloneNode(true));
            sinBio.hidden = Boolean(bio.textContent?.trim() || bio.querySelector('img, video, audio, hr'));
        } else {
            // Other profile cards still provide plain-text paragraph arrays.
            bio.replaceChildren(...parrafos.map((text) => {
                const p = document.createElement('p');
                p.textContent = text;
                return p;
            }));
            sinBio.hidden = parrafos.length > 0;
        }
        let visibleLinks = 0;
        sociales.querySelectorAll<HTMLAnchorElement>('[data-persona-red]').forEach((anchor) => {
            const url = links[anchor.dataset.personaRed!];
            let valid = false;
            try { valid = ['https:', 'http:'].includes(new URL(url).protocol); } catch { /* Missing or invalid URL. */ }
            anchor.hidden = !valid;
            anchor.removeAttribute('href');
            if (valid) {
                anchor.href = url;
                anchor.setAttribute('aria-label', `${anchor.title} de ${nombre.textContent} (abre en otra pestaña)`);
                visibleLinks++;
            }
        });
        sociales.hidden = visibleLinks === 0;
        ultimaCard = card;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        root.showModal();
        root.scrollTop = 0;
        closeBtn.focus();
    };
    document.querySelectorAll<HTMLElement>('[data-persona-card]').forEach((card) => card.addEventListener('click', () => abrir(card)));
    closeBtn.addEventListener('click', () => root.close());
    root.addEventListener('click', (event) => {
        if (event.target !== root) return;
        const rect = root.getBoundingClientRect();
        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) root.close();
    });
    root.addEventListener('close', () => {
        document.body.style.overflow = previousOverflow;
        ultimaCard?.focus();
        ultimaCard = null;
    });
</script>
