---
import { getCollection } from 'astro:content';
import 'swiper/css';
import 'swiper/css/a11y';
import { link } from '../../lib/link.ts';
import IconoChevron from '../IconoChevron.astro';
import {Image} from "astro:assets";

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/formaciones/*.{jpeg,jpg,png,webp}', { eager: true });

const formaciones = await getCollection('formaciones');

const slideItems = formaciones
    .map((formacion) => {
      const frontmatter = formacion.data;
      let resolvedImage = undefined;
      let imageSrcString = '';
      if (frontmatter.imagen) {
        const imageName = frontmatter.imagen.split('/').pop();
        const matchedKey = Object.keys(imageFiles).find((path) => path.endsWith(`/${imageName}`));
        if (matchedKey) {
          resolvedImage = imageFiles[matchedKey].default;
          imageSrcString = resolvedImage.src;
        } else {
          imageSrcString = frontmatter.imagen;
        }
      }
      return {
        slug: frontmatter.slug,
        titulo: frontmatter.titulo,
        imagen: resolvedImage, // Optimized ImageMetadata object for <Image />
        imagenUrl: imageSrcString, // Raw string URL for data attributes
        peso: Number.isFinite(frontmatter.peso) ? frontmatter.peso : undefined,
      };
    })
    .sort((a, b) => {
      if (a.peso === undefined && b.peso === undefined) {
        return a.titulo.localeCompare(b.titulo, 'es');
      }
      if (a.peso === undefined) return 1;
      if (b.peso === undefined) return -1;
      return a.peso - b.peso;
    });


// Keep full copies on both sides before Swiper starts. The extra loop buffer
// lets Swiper recycle offscreen slides without exposing either end of the track.
const slides = [...slideItems];
---

<section id="formaciones" class="formaciones-carousel-n full-bleed mt-14 overflow-clip bg-[#5b11331a] px-2.5 py-5 font-heading text-base leading-[1.7] text-[#1e1e1e] md:p-[50px] [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-4 [&_:focus-visible]:outline-[#8c1c3f]" aria-labelledby="formaciones-n-titulo">
  <div class="mx-auto flex max-w-[1140px] flex-col gap-5 max-[1024px]:max-w-[1024px]">
    <header class="p-2.5">
       <p class="m-0 mb-2 text-center text-xs font-semibold uppercase tracking-widest text-accent md:text-left">Formaciones</p>
      <h2 id="formaciones-n-titulo" class="m-0 mb-5 text-center font-display text-[38px] font-bold uppercase leading-[1.2] tracking-[-1px] text-[#8c1c3f] md:text-left md:text-5xl md:leading-[72px]">Nuestras formaciones</h2>
      <p class="m-0 mb-[33px] w-full leading-[1.8] md:mb-0 md:w-4/5 md:leading-[1.7]">La facultad ofrece <strong>formaciones en psicología y psicoanálisis online</strong> que integran teoría y clínica para profundizar en el estudio del inconsciente y la comprensión de la subjetividad contemporánea.</p>
    </header>
    <formaciones-carousel-n data-course-count={slides.length}   class="relative left-1/2 block w-screen max-w-none -translate-x-1/2 px-0 pt-0">
      <div class="mx-auto mb-5 flex w-full max-w-[1140px] justify-end gap-2 px-5 max-[1024px]:max-w-[1024px]">
        <button data-carousel-prev class="formaciones-n-nav" type="button" aria-label="Formación anterior">
          <IconoChevron class="size-4 rotate-90" /><span>Anterior</span>
        </button>
        <button data-carousel-next class="formaciones-n-nav" type="button" aria-label="Formación siguiente">
          <span>Siguiente</span><IconoChevron class="size-4 -rotate-90" />
        </button>
      </div>
      <div class="e-n-carousel swiper relative w-full overflow-hidden
  [&:not(.swiper-initialized)_.swiper-wrapper]:gap-2.5
  [&:not(.swiper-initialized)_.swiper-slide]:w-full!
  md:[&:not(.swiper-initialized)_.swiper-slide]:w-[calc((100%_-_10px)/2)]!" role="region" aria-roledescription="carrusel" aria-label="Formaciones" tabindex="0">
        <div class="swiper-wrapper">
          {slides.map((formacion, index) => (

            <article class="swiper-slide h-auto! shrink-0 p-2.5" role="group" aria-roledescription="diapositiva" data-course-index={index % slides.length} aria-label={`${index % slides.length + 1} de ${slides.length}`}>
              <div class="flex flex-col gap-5 p-2.5">
                <a class="group block" href={link(formacion.slug ?? '#')} tabindex="-1" aria-hidden="true">

                  <Image
                      src={formacion.imagen}
                      alt={formacion.titulo}
                      class="block rounded-xl aspect-video h-auto w-full transition-transform duration-300 group-hover:scale-110 motion-reduce:transform-none motion-reduce:transition-none"
                      loading="eager"
                      decoding="async"
                      width="1024" height="576"
                  />

                </a>
                <h3 class="m-0 font-display text-lg font-bold uppercase leading-[25px] tracking-[-.5px] md:text-xl"><a class="text-[#5b1133] transition-colors duration-1000 hover:text-[#8c1c3f] hover:no-underline focus:text-[#8c1c3f] focus:no-underline motion-reduce:transition-none" href={formacion.slug}>{formacion.titulo}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
      <button class="formaciones-n-pause sr-only absolute focus-visible:not-sr-only focus-visible:absolute focus-visible:right-2.5 focus-visible:bottom-0 focus-visible:z-2 focus-visible:bg-[#5b1133] focus-visible:px-3 focus-visible:py-2 focus-visible:[font:inherit] focus-visible:text-white" type="button" aria-pressed="false">Pausar carrusel</button>
    </formaciones-carousel-n>
    <a class="self-center rounded-[3px] bg-[#5b1133] px-8 py-4 text-center text-base font-extrabold uppercase leading-none text-[#fffafa] transition-colors duration-300 hover:bg-[#65002a] hover:no-underline focus:bg-[#65002a] focus:no-underline motion-reduce:transition-none" href="https://go.facultadlalangue.com/entrevista-directa">Postulate para una beca</a>
  </div>
</section>

<style>
  .formaciones-n-nav { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; padding: 10px 16px; border: 1px solid #5b11332b; border-radius: 999px; color: #5b1133; background: transparent; font: inherit; font-size: 12px; cursor: pointer; transition: background .2s, color .2s; }
  .formaciones-n-nav:hover:not(:disabled) { background: #5b1133; color: white; }
  .formaciones-n-nav:disabled { opacity: .3; cursor: default; }
  @media (prefers-reduced-motion: reduce) {
    .formaciones-n-nav { transition: none; }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { A11y, Autoplay, Keyboard, Navigation } from 'swiper/modules';

  class FormacionesCarouselN extends HTMLElement {
    private swiper?: Swiper;
    private events?: AbortController;

    connectedCallback() {
      if (this.swiper) return;
      const carousel = this.querySelector<HTMLElement>('.swiper');
      const pause = this.querySelector<HTMLButtonElement>('.formaciones-n-pause');
      const previous = this.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!carousel || !pause || !previous || !next) return;
      this.events = new AbortController();
      const { signal } = this.events;
      const courseCount = Number(this.dataset.courseCount);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let userPaused = reducedMotion.matches;
      const updatePause = () => {
        pause.setAttribute('aria-pressed', String(userPaused));
        pause.textContent = userPaused ? 'Reanudar carrusel' : 'Pausar carrusel';
      };
      this.swiper = new Swiper(carousel, {
        modules: [A11y, Autoplay, Keyboard, Navigation],
        slidesPerView: 1,
        slidesPerGroup: 1,
        centeredSlides: false,
        spaceBetween: 10,
        loop: courseCount >= 4,
        loopAdditionalSlides: 0,
        initialSlide: 0,
        speed: reducedMotion.matches ? 0 : 2000,
        grabCursor: true,

        breakpoints: {
          768: {
            slidesPerView: 2,
          },
          // Preserve the original desktop layout, including its track offsets.
          1024: {
            slidesPerView: 2,
            slidesOffsetBefore: () => window.innerWidth * 0.2,
            slidesOffsetAfter: () => window.innerWidth * 0.2,
          },
        },

        autoplay: {
          delay: 1000,
          pauseOnMouseEnter: true,
          disableOnInteraction: true,
        },

        keyboard: {
          enabled: true,
          onlyInViewport: true,
        },

        navigation: {
          prevEl: previous,
          nextEl: next,
          addIcons: false,
        },

        a11y: {
          prevSlideMessage: 'Formación anterior',
          nextSlideMessage: 'Formación siguiente',
          containerRoleDescriptionMessage: 'carrusel',
          itemRoleDescriptionMessage: 'diapositiva',
          slideLabelMessage: '',
        },
        slidesOffsetBefore: 0,
        slidesOffsetAfter: 0,

      });
      if (userPaused) this.swiper.autoplay.stop();
      updatePause();
      pause.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) this.swiper?.autoplay.stop();
        else this.swiper?.autoplay.start();
        updatePause();
      }, { signal });
      carousel.addEventListener('focusin', () => this.swiper?.autoplay.stop(), { signal });
      reducedMotion.addEventListener('change', (event) => {
        userPaused = event.matches;
        if (this.swiper) {
          this.swiper.params.speed = event.matches ? 0 : 2000;
          if (userPaused) this.swiper.autoplay.stop();
        }
        updatePause();
      }, { signal });
    }

    disconnectedCallback() {
      this.events?.abort();
      this.swiper?.destroy(true, true);
      this.swiper = undefined;
    }
  }

  if (!customElements.get('formaciones-carousel-n')) {
    customElements.define('formaciones-carousel-n', FormacionesCarouselN);
  }
</script>
